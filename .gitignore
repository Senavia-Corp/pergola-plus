# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
.vercel

# Staging de la migracion de imagenes (Fase 0.5).
# Los binarios NO van a git: viven en Sanity y pesan ~100 MB.
# manifest.json SI se versiona: es el mapa URL-de-Webflow -> archivo -> _id de Sanity,
# y es lo que permite rehacer la importacion.
assets-migracion/design/
assets-migracion/content/

# public/cms-img/ (503 archivos, 116 MB) SI va a git a proposito, aunque sea
# provisional hasta el CDN de Sanity en la Fase 3. El sitio despliega por
# `git push` y Vercel construye desde un CLON: mientras estuvo ignorada, las 427
# urls del CMS devolvian 404 en el sitio desplegado y en local todo pasaba en
# verde. Lo comprueba el check 4b de comprobar-imagenes.mjs.

# Videos del hero. Solo se versionan los 2 que el HTML pide de verdad (18 MB).
# El .mp4 sin sufijo (27 MB) y el _poster.jpg no los referencia ninguna pagina:
# instalar-assets.mjs los copia igual, pero no hace falta desplegarlos.
public/videos/*
!public/videos/Bd-video-pergola-plus-Final_mp4.mp4
!public/videos/Bd-video-pergola-plus-Final_webm.webm

# Leads recibidos en local por /api/lead. Datos personales reales: NO van a git.
# Se regenera solo, enviando cualquiera de los 3 formularios.
.leads/

# Auditoria de nitidez.
#
# El informe y la cola SI se versionan: son el resultado del trabajo (que imagenes
# hay que regenerar y por que), y la cola es ademas el mapa nombre->ruta con el que
# vuelven los ficheros de Higgsfield. Sin ella en el repo, integrar-higgsfield.mjs
# no sabe a donde va cada archivo.
#
# display.json NO: es la cache de la pasada de navegador (~15 min de Playwright).
# Se regenera sola y no dice nada que no diga el informe.
auditoria-imagenes/display.json
# Los montajes antes/despues son imagenes y se rehacen en cada integracion.
auditoria-imagenes/comparativas/

# Lo crea `vercel link` con el VERCEL_OIDC_TOKEN del proyecto.
# El CLI escribe aqui `.env*` a secas, y eso taparia .env.example — que SI se
# versiona a proposito: es la documentacion de todas las variables del sitio.
.env.local
