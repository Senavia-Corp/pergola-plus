---
/**
 * El puente de una ficha de producto o servicio a la biblioteca de preguntas,
 * ya filtrada por su tema.
 *
 * VA DENTRO DE LA LISTA DE PREGUNTAS, como su ultimo hijo. El fragmento migrado se
 * parte para eso en src/lib/faq-ficha.ts — ahi esta explicado por que no se inyecta
 * en el fragmento (lo reescribe el generador, y el reescritor de enlaces al español
 * descarta los href con `?`) y por que no cuelga del grid como cuarto hijo.
 *
 * Antes se montaba DESPUES del fragmento entero, y el resultado era un boton suelto
 * al final de la pagina, por debajo del CTA y sin nada alrededor.
 *
 * La ficha conserva su bloque de 5 preguntas: son el contenido indexable de la
 * pagina que manda para ese producto. Esto solo abre la puerta al resto.
 */
import { TEMAS_FICHA, type Tema } from '../data/faqs';
import { TEMAS_COPY, TEXTOS_FAQ, traducidas, type Idioma } from '../i18n/faqs.es';

interface Props {
  /** El slug de la ficha. Tiene que ser uno de TEMAS_FICHA. */
  tema: string;
  idioma?: Idioma;
}

const { tema, idioma = 'en' } = Astro.props;

if (!TEMAS_FICHA.has(tema as Tema)) {
  throw new Error(`[faqs] "${tema}" no es un tema de ficha: no puede recibir ?t=`);
}

const cuantas = traducidas(idioma).filter((f) => f.tema === tema).length;
const t = TEXTOS_FAQ[idioma];
const base = idioma === 'es' ? '/es/resources/faq' : '/resources/faq';
const rotulo = t.verTodas
  .replace('{n}', String(cuantas))
  .replace('{tema}', TEMAS_COPY[idioma][tema as Tema]);
---

{
  cuantas > 0 && (
    <div class="pp-faq-puente">
      <a class="pp-faq-puente-a" href={`${base}?t=${tema}`}>
        {rotulo}
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
          <path
            d="M3 8h10M9 4l4 4-4 4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    </div>
  )
}

<style>
  /* En servicios la lista (.wrapper-faq) es flex en columna con gap 2rem: sin
     align-self el boton se estiraria a todo el ancho de la columna. En productos
     (.div-block-10) es un bloque y el margen es el que separa. La propiedad que
     sobra en cada caso no molesta en el otro. */
  .pp-faq-puente {
    align-self: flex-start;
    margin-top: 1.5rem;
  }

  .pp-faq-puente-a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.4rem;
    border: 1px solid var(--primary);
    border-radius: 999px;
    color: var(--primary);
    font-weight: 500;
  }

  .pp-faq-puente-a:hover {
    background-color: var(--primary);
    color: var(--white);
  }

  .pp-faq-puente-a:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
  }
</style>
