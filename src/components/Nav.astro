---
// Nav — CODIGO DE AUTORIA PROPIA. Se edita a mano.
//
// Nacio como extraccion de index.html via scripts/generar-shell.mjs, pero desde
// el rediseno del menu ya no se genera: ese script esta retirado tras el flag
// --regenerar-shell y sobrescribir este archivo perderia el rediseno.
//
// Los data-w-id se conservan TAL CUAL. Los 18 de los .submenu-item son 18 pares
// MOUSE_OVER/MOUSE_OUT con mediaQueries:["main"] que intercambian la imagen de
// preview del mega-menu: son las UNICAS interacciones de hover de todo el sitio.
// El 19o (...dd88df62, en <nav class="menu">) lleva PAGE_SCROLL_DOWN +
// SCROLL_INTO_VIEW en los 4 breakpoints. Borrar uno mata su animacion en
// silencio, sin error.
//
// Lo que NO hay que tocar: la estructura w-dropdown / w-dropdown-toggle /
// w-dropdown-list y las clases w-nav*. La apertura de los paneles y del menu
// movil la hacen los modulos `dropdown` y `navbar` de webflow.js apoyandose en
// esas clases; no es IX2 (no existen eventos DROPDOWN_OPEN ni NAVBAR_OPEN en la
// configuracion de este sitio).
import '../styles/menu.css';
import { idiomaDeRuta, rutaEnIdioma } from '../i18n';
import { traductor } from '../i18n/shell';

const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const idioma = idiomaDeRuta(Astro.url.pathname);
const t = traductor(idioma);
const esActiva = (href: string) => (href === '/' ? ruta === '/' : ruta === href || ruta.startsWith(href + '/'));

// Los enlaces "View all" apuntan a la pagina indice, asi que quieren coincidencia
// EXACTA: estando en /products/cabanas la seccion esta activa, pero "View all
// products" no lo esta.
const esExacta = (href: string) => ruta === href;

// --- Selector de idioma -----------------------------------------------------
// Las banderas van INLINE y dibujadas aqui a proposito. public/images/En.svg y
// Sp.svg no valen: no traen ni bloque <style> ni atributos fill, asi que todos
// sus paths heredarian negro y se verian como dos rectangulos negros. Ademas
// Sp.svg pesa 113 KB por un escudo de 481 paths que a 22 px no se ve. Estas dos
// pesan ~300 bytes y llevan el color puesto por construccion.
//
// Sin clipPath: dos instancias del mismo SVG en la pagina duplicarian el id. El
// recorte circular lo hace el CSS con border-radius + overflow en el <span>.
const BANDERA_EN = `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMid slice">
  <rect width="24" height="24" fill="#fff"/>
  <g fill="#b22234"><rect width="24" height="1.85"/><rect y="3.7" width="24" height="1.85"/><rect y="7.4" width="24" height="1.85"/><rect y="11.1" width="24" height="1.85"/><rect y="14.8" width="24" height="1.85"/><rect y="18.5" width="24" height="1.85"/><rect y="22.2" width="24" height="1.85"/></g>
  <rect width="10.5" height="9.25" fill="#3c3b6e"/>
  <g fill="#fff"><circle cx="2.2" cy="2" r=".75"/><circle cx="5.3" cy="2" r=".75"/><circle cx="8.4" cy="2" r=".75"/><circle cx="3.7" cy="4.6" r=".75"/><circle cx="6.8" cy="4.6" r=".75"/><circle cx="2.2" cy="7.2" r=".75"/><circle cx="5.3" cy="7.2" r=".75"/><circle cx="8.4" cy="7.2" r=".75"/></g>
</svg>`;
const BANDERA_ES = `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMid slice">
  <rect width="24" height="24" fill="#c60b1e"/><rect y="6" width="24" height="12" fill="#ffc400"/>
</svg>`;

// Los nombres van SIEMPRE en su propio idioma, nunca traducidos.
// El destino lo calcula rutaEnIdioma(): hoy en español solo existe la home, y
// cuando haya más páginas traducidas ese es el único sitio que hay que tocar.
const IDIOMAS = [
  { codigo: 'EN', lang: 'en', nombre: 'English', href: rutaEnIdioma(Astro.url.pathname, 'en'), bandera: BANDERA_EN, activo: idioma === 'en' },
  { codigo: 'ES', lang: 'es', nombre: 'Español', href: rutaEnIdioma(Astro.url.pathname, 'es'), bandera: BANDERA_ES, activo: idioma === 'es' },
];
const idiomaActual = IDIOMAS.find((i) => i.activo)!;
