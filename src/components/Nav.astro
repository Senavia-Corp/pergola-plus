        {/* Selector de idioma. UNA sola instancia, colocada entre el nav-menu y
            la hamburguesa dentro de .wrapper-menu (que es flex). Con eso cae
            sola donde toca en los dos breakpoints:
              >=992px  el nav-menu ocupa el ancho, asi que queda al final de la
                       fila, a la derecha de los CTA y tras un divisor.
              <=991px  el nav-menu se va a panel fijo fuera de flujo, asi que la
                       fila queda logo + selector + hamburguesa: visible SIN
                       abrir el menu, que es justo lo que necesita alguien que
                       llega y no entiende la pagina.
            Nada de duplicar markup por breakpoint. */}
        <div class="idioma" data-idioma>
          <button
            type="button"
            class="idioma-boton"
            id="idioma-boton"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="idioma-lista"
            aria-label={`${t('cambiarIdioma')} ${idiomaActual.nombre}`}>
            <span class="idioma-bandera" set:html={idiomaActual.bandera} />
            <span class="idioma-codigo">{idiomaActual.codigo}</span>
            <svg class="idioma-chevron" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>

          {/* Enlaces reales, no un listbox: son destinos, no valores que se
              eligen. Asi funcionan sin JS, admiten abrir en pestana nueva y el
              hreflang es valido. El brief pedia aria-haspopup="listbox", pero
              anunciar enlaces como opciones de un listbox enganaria al lector de
              pantalla. Las flechas se manejan igual desde el teclado. */}
          <ul class="idioma-lista" id="idioma-lista" hidden>
            {IDIOMAS.map((i) => (
              <li>
                <a
                  href={i.href}
                  lang={i.lang}
                  hreflang={i.lang}
                  class:list={['idioma-opcion', { 'es-actual': i.activo }]}
                  aria-current={i.activo ? 'true' : undefined}>
                  <span class="idioma-bandera" set:html={i.bandera} />
                  <span class="idioma-nombre">{i.nombre}</span>
                  {i.activo && (
                    <svg class="idioma-check" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                      <path d="M3 8.5l3.5 3.5L13 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="menu-button w-nav-button">
          <div class="w-icon-nav-menu"></div>
        </div>
      </div>
    </div>
  </nav>

<script>
  // Precalienta las imagenes de preview del mega-menu.
  //
  // El problema: las .preview-image son loading="lazy" Y display:none, asi que
  // el navegador no las descarga NUNCA. Cuando IX2 revela una al pasar el raton
  // por un item, la caja sale en blanco hasta que llega el fetch (medido:
  // complete:false / naturalWidth:0 en 7 de las 10 de productos).
  //
  // No se puede arreglar con loading="eager": son 2,4 MB entre las 19 y se
  // descargarian en CADA pagina. Se descargan al apuntar al desplegable, que da
  // margen de sobra antes del primer hover, y solo a quien abre el menu.
  //
  // Solo en escritorio: a <=991px la columna de imagen esta oculta.
  const anchoEscritorio = window.matchMedia('(min-width: 992px)');

  for (const desplegable of document.querySelectorAll<HTMLElement>('.menu .dropdown')) {
    const imagenes = desplegable.querySelectorAll<HTMLImageElement>('.preview-image');
    if (!imagenes.length) continue;

    const precalentar = () => {
      if (!anchoEscritorio.matches) return;
      for (const img of imagenes) new Image().src = img.src;
    };

    const disparador = desplegable.querySelector<HTMLElement>('.w-dropdown-toggle');
    disparador?.addEventListener('pointerenter', precalentar, { once: true });
    disparador?.addEventListener('focus', precalentar, { once: true });
  }

  // --- Teclado de los desplegables: NO hace falta añadir nada ---------------
  //
  // Se auditó porque Daniel se quejó de los dropdowns, y aquí llegó a haber un
  // manejador de Escape propio. Se quitó: el módulo `dropdown` de webflow.js ya
  // lo trae todo, enlazado como `keydown.w-dropdown` sobre el elemento
  // `.w-dropdown` —no sobre document—:
  //
  //   ESCAPE                cierra y devuelve el foco al disparador
  //   ARROW_UP/DOWN/L/R     mueve el foco por los enlaces del panel
  //   HOME / END            primer y último enlace
  //   SPACE / ENTER         abre, desde el disparador
  //   focusout              cierra al salir el foco del desplegable
  //
  // La trampa que costó el rato: al estar enlazado en `.w-dropdown`, Escape solo
  // llega si el evento BURBUJEA desde dentro (foco en el disparador o en un
  // enlace del panel). Una sonda que hace
  // `document.dispatchEvent(new KeyboardEvent('keydown', {key:'Escape'}))`
  // no baja a los descendientes, así que informa de que Escape no cierra cuando
  // sí cierra. Si vuelves a medir esto, despacha sobre un elemento de dentro.
  //
  // Y el manejador de Escape del panel MÓVIL de más abajo no cubre el caso de
  // escritorio —está detrás de un `if (!estaAbierto())` que pregunta por la
  // hamburguesa—, pero no importa: no hay nada que cubrir.
  //
  // El `focusout` de Webflow además está bien guardado contra el
  // `relatedTarget: null` de iOS, porque comprueba también `target`.

  // --- Panel móvil ----------------------------------------------------------
  // El módulo `navbar` de Webflow abre y cierra el panel, pero no hace nada más:
  // medido con el panel abierto en 375x812 —Escape no cerraba, la página de
  // detrás seguía haciendo scroll y quedaban 70 elementos enfocables fuera del
  // panel, tapados visualmente pero alcanzables con Tab—.
  //
  // No se reimplementa la apertura: se observa la clase `w--open` que pone
  // Webflow y se añade encima lo que falta.
  const botonMenu = document.querySelector<HTMLElement>('.menu .w-nav-button');
  const panelMenu = document.querySelector<HTMLElement>('.menu .nav-menu');

  if (botonMenu && panelMenu) {
    const estaAbierto = () => botonMenu.classList.contains('w--open');
    const cerrar = () => botonMenu.click(); // el propio módulo hace el resto

    const enfocablesDelPanel = () =>
      [...panelMenu.querySelectorAll<HTMLElement>('a[href], button, input, [tabindex]:not([tabindex="-1"])')]
        .filter((e) => e.offsetParent !== null);

    const alTeclear = (e: KeyboardEvent) => {
      if (!estaAbierto()) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        cerrar();
        botonMenu.focus();
        return;
      }

      if (e.key !== 'Tab') return;

      // Foco atrapado: la hamburguesa es el primer parada del ciclo para que
      // cerrar esté siempre a un Tab de distancia.
      const ciclo = [botonMenu, ...enfocablesDelPanel()];
      if (!ciclo.length) return;

      const actual = document.activeElement as HTMLElement;
      const i = ciclo.indexOf(actual);
      const dentro = i !== -1;

      if (!dentro) {
        e.preventDefault();
        ciclo[0].focus();
        return;
      }

      const ultimo = ciclo.length - 1;
      if (!e.shiftKey && i === ultimo) {
        e.preventDefault();
        ciclo[0].focus();
      } else if (e.shiftKey && i === 0) {
        e.preventDefault();
        ciclo[ultimo].focus();
      }
    };

    document.addEventListener('keydown', alTeclear);

    // Con el scrim, el scroll bloqueado y el foco atrapado, el panel es modal de
    // hecho. `inert` lo termina de decir: saca del árbol de accesibilidad todo
    // lo que está tapado, que si no sigue siendo explorable con lector de
    // pantalla aunque el Tab ya no llegue.
    const hermanos = () =>
      [...document.body.children].filter((e) => e !== document.querySelector('.menu'));

    // Bloqueo del scroll de fondo. Se marca <html> y el resto lo hace el CSS.
    // ponytail: con overflow:hidden basta en iOS 16+ y en Android; si algún día
    // hace falta soportar iOS 15, el patrón es fijar el body guardando scrollY.
    const observador = new MutationObserver(() => {
      const abierto = estaAbierto();
      document.documentElement.classList.toggle('menu-movil-abierto', abierto);
      for (const e of hermanos()) (e as HTMLElement).inert = abierto;
    });
    observador.observe(botonMenu, { attributes: true, attributeFilter: ['class'] });
  }

  // --- Selector de idioma ---------------------------------------------------
  // Se escribe a mano en vez de reusar el modulo dropdown de Webflow: ese exige
  // la estructura w-dropdown/w-dropdown-list y meteria este control en el mismo
  // grupo que los 5 paneles del menu, con los que no tiene nada que ver.
  const selector = document.querySelector<HTMLElement>('[data-idioma]');

  if (selector) {
    const boton = selector.querySelector<HTMLButtonElement>('.idioma-boton')!;
    const lista = selector.querySelector<HTMLElement>('.idioma-lista')!;
    const opciones = [...lista.querySelectorAll<HTMLAnchorElement>('.idioma-opcion')];

    const abrir = (abierto: boolean) => {
      boton.setAttribute('aria-expanded', String(abierto));
      lista.hidden = !abierto;
      selector.classList.toggle('esta-abierto', abierto);
    };

    const cerrarYDevolverFoco = () => {
      abrir(false);
      boton.focus();
    };

    boton.addEventListener('click', () => {
      const abierto = boton.getAttribute('aria-expanded') === 'true';
      abrir(!abierto);
      if (!abierto) opciones[0]?.focus();
    });

    // Flechas para moverse, Home/End a los extremos, Escape cierra.
    selector.addEventListener('keydown', (e) => {
      const ev = e as KeyboardEvent;

      if (ev.key === 'Escape') {
        if (boton.getAttribute('aria-expanded') === 'true') {
          ev.preventDefault();
          cerrarYDevolverFoco();
        }
        return;
      }

      if (ev.key === 'ArrowDown' && document.activeElement === boton) {
        ev.preventDefault();
        abrir(true);
        opciones[0]?.focus();
        return;
      }

      const i = opciones.indexOf(document.activeElement as HTMLAnchorElement);
      if (i === -1) return;

      if (ev.key === 'ArrowDown' || ev.key === 'ArrowUp') {
        ev.preventDefault();
        const paso = ev.key === 'ArrowDown' ? 1 : -1;
        opciones[(i + paso + opciones.length) % opciones.length].focus();
      } else if (ev.key === 'Home') {
        ev.preventDefault();
        opciones[0].focus();
      } else if (ev.key === 'End') {
        ev.preventDefault();
        opciones[opciones.length - 1].focus();
      }
    });

    // Clic fuera y foco fuera (Tab hacia adelante desde la ultima opcion).
    document.addEventListener('click', (e) => {
      if (!selector.contains(e.target as Node)) abrir(false);
    });
    selector.addEventListener('focusout', () => {
      // Se aplaza: en el momento del focusout, activeElement todavia es <body>.
      setTimeout(() => {
        if (!selector.contains(document.activeElement)) abrir(false);
      }, 0);
    });
  }
</script>
