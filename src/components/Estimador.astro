---
import type { TextosEstimador } from '../i18n/estimador';
import {
  PRODUCTOS,
  MONTAJE,
  SUPERFICIES,
  SUPERFICIE_MAX,
  MEJORAS,
  CONDADOS,
  INGENIERIA,
  WATERFRONT,
  PRESETS,
  PRESET_POR_DEFECTO,
  MIN_FT,
  MAX_FT,
  ANCHO_POR_DEFECTO,
  LARGO_POR_DEFECTO,
} from '../data/estimador';

// Estimador de presupuesto. CODIGO DE AUTORIA PROPIA.
//
// Vive en un componente y no en la pagina porque hay DOS paginas —/project-estimator
// y /es/project-estimator— y ni los precios ni la logica pueden estar duplicados. Lo
// que cambia entre idiomas son los rotulos y los enlaces internos.
//
// Las tarifas NO estan aqui: viven en src/data/estimador.ts, con su procedencia.
// Los rotulos tampoco: viven en src/i18n/estimador.ts, uno por idioma. La bisagra
// entre las tres piezas es el `id`.
//
// Se maqueta con las mismas clases que el resto del sitio (.header-page / .container
// / .body-page) para que no se note la costura.
//
// Sin wfPage/wfSite a proposito: `data-wf-page` solo lo consulta IX2 para ids con
// delimitador "|" (page-scoped), y ninguno de los 4 del footer ni de los 18 del nav
// lo lleva. Esta pagina no tiene interacciones propias, asi que tampoco necesita
// bloque anti-FOUC.
//
// POR QUE UN STEPPER PROPIO Y NO EL DE Formulario.astro
//
// El wizard `.msf-step` es lineal y valida con checkValidity() al avanzar. Aqui hay
// ramificacion —cabana y carport son exentas por definicion y se saltan el paso 2;
// solar y Sukkha no llevan tarifa y van derechos al cierre— y recalculo en vivo en
// cada pulsacion. Lo que si se reutiliza de Formulario.astro es todo lo del paso 8:
// con solo llevar action="/api/lead", el formulario de captura hereda el resumen de
// errores accesible, el envio por fetch y el redirect bilingue.

interface Props {
  t: TextosEstimador;
  /** '' en ingles, '/es' en español. Prefijo de los enlaces internos. */
  base?: string;
}
const { t, base = '' } = Astro.props;

const productos = PRODUCTOS.map((p) => ({
  ...p,
  ...t.productos[p.id]!,
  href: base + p.href,
}));

const mejoras = MEJORAS.map((m) => ({ ...m, ...t.mejoras[m.id]! }));

// El vocabulario del formulario de cotizacion largo, palabra por palabra
// (contact-us/get-a-quote, select#Shade-Structure). Un lead del estimador y uno del
// formulario tienen que decir lo MISMO cuando llegan al comercial: si aqui pusiera
// "Open-Air Pergola" y alli "Open-Air Aluminum Pergola", nadie podria contarlos
// juntos. No se traduce nunca.
const NOMBRE_LEAD: Record<string, string> = {
  'open-air': 'Open-Air Pergola',
  insulated: 'Insulated Roof Pergola',
  polycarbonate: 'Polycarbonate Pergola',
  louvered: 'Louvered Roof Pergola',
  cabana: 'Aluminum Cabana',
  screens: 'Screen Enclosure',
  carport: 'Aluminum Carport',
  solar: 'Solar Roof Structure',
  sukkha: 'Sukkha 3000 System',
};

// Y lo mismo con el resto de respuestas. Los `id` internos estan en español porque
// el codigo lo esta, pero el comercial que abre el aviso no tiene por que leer
// "cesped" ni "nueva-pavers": lo que llega al lead va en el idioma del despacho,
// igual para un visitante ingles que para uno español.
const VOCABULARIO_LEAD: Record<string, Record<string, string>> = {
  montaje: { adosada: 'Attached to house', exenta: 'Free-standing' },
  suelo: {
    'losa-ok': 'Existing concrete slab',
    'pavers-ok': 'Existing pavers',
    cesped: 'Grass / dirt / sand',
    'deck-madera': 'Wood deck',
    'no-se': 'Not sure',
  },
  base: { 'nueva-losa': 'New concrete slab', 'nueva-pavers': 'New paver base' },
  agua: { si: 'Yes', no: 'No' },
  hoa: { si: 'Yes', no: 'No', 'no-se': 'Not sure' },
  espejo: { encaja: 'Fits', alto: 'A little high', premium: 'Can invest more' },
};

// El dinero se formatea SIEMPRE en en-US, tambien en la version española: son
// dolares en Florida, y "$34,000" es como los escribe y los lee ahi todo el mundo.
// Con es-ES saldria "$34.000", que a un vecino de Hialeah le parece otra cifra.
const datos = JSON.stringify({
  productos: PRODUCTOS.map((p) => ({
    id: p.id,
    tarifa: p.tarifa && { min: p.tarifa.min, max: p.tarifa.max, techoAbierto: !!p.tarifa.techoAbierto },
    siempreExenta: !!p.siempreExenta,
    nombre: t.productos[p.id]!.nombre,
    lead: NOMBRE_LEAD[p.id],
  })),
  montaje: MONTAJE,
  superficies: Object.fromEntries(
    Object.entries(SUPERFICIES).map(([k, v]) => [k, { min: v.min, max: v.max }]),
  ),
  superficieMax: SUPERFICIE_MAX,
  mejoras: MEJORAS.map((m) => ({
    id: m.id,
    grupo: m.grupo ?? null,
    tarifa: m.tarifa && { min: m.tarifa.min, max: m.tarifa.max, techoAbierto: !!m.tarifa.techoAbierto },
    nombre: t.mejoras[m.id]!.nombre,
  })),
  condados: CONDADOS,
  vocabulario: VOCABULARIO_LEAD,
  ingenieria: { min: INGENIERIA.min, max: INGENIERIA.max },
  waterfront: { min: WATERFRONT.min, max: WATERFRONT.max },
  limites: { min: MIN_FT, max: MAX_FT },
  // `panelVacio` se pinta en el servidor (estado inicial) y tambien en el navegador
  // cuando se deselecciona: viaja aqui para no tener la misma frase escrita dos
  // veces por idioma.
  textos: { ...t.cliente, panelVacio: t.panelVacio },
});

const paginaActual = Astro.url.pathname;
---

<header class="header-page">
  <div class="w-layout-blockcontainer container w-container">
    <h1>{t.h1}</h1>
    <p>{t.entradilla}</p>
  </div>
</header>

<section class="body-page est-seccion">
  <div class="w-layout-blockcontainer container w-container">
    <div class="est">
      <div class="est-pasos" id="est-pasos">
        <!-- El contador y la barra los rellena el script: sin JS no hay pasos que
             contar, y la pagina cae al camino <noscript> de mas abajo. -->
        <div class="est-progreso" id="est-progreso" hidden>
          <div class="est-barra"><span id="est-barra-relleno"></span></div>
          <p class="est-progreso-texto" id="est-progreso-texto" aria-live="polite"></p>
        </div>

        <form class="est-form" id="est-form" novalidate>
          <!-- 1 · que quieres que haga ------------------------------------- -->
          <fieldset class="est-bloque est-paso" data-paso="1">
            <legend class="est-legend">{t.paso1}</legend>
            <p class="est-ayuda">{t.ayuda1}</p>
            <div class="est-opciones">
              {
                productos.map((p) => (
                  <label class="est-opcion est-opcion--foto">
                    {/* alt vacio a proposito: la foto es redundante con el rotulo
                        que va justo debajo, y describirla otra vez solo anade ruido
                        para quien navega con lector de pantalla. */}
                    <img class="est-foto" src={p.imagen} alt="" loading="lazy" />
                    <span class="est-opcion-fila">
                      <input type="radio" name="producto" value={p.id} />
                      <span class="est-opcion-cuerpo">
                        <span class="est-opcion-titulo">{p.nombre}</span>
                        <span class="est-opcion-nota">{p.nota}</span>
                        <span class="est-opcion-tarifa">
                          {
                            p.tarifa ? (
                              <>
                                {t.desde} ${p.tarifa.min}–${p.tarifa.max}
                                {p.tarifa.techoAbierto ? '+' : ''}{' '}
                                <span class="est-unidad">{t.porPie}</span>
                              </>
                            ) : (
                              <span class="est-unidad">{t.aMedidaEtiqueta}</span>
                            )
                          }
                        </span>
                      </span>
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <!-- 2 · montaje ---------------------------------------------------- -->
          <fieldset class="est-bloque est-paso" data-paso="2">
            <legend class="est-legend">{t.paso2}</legend>
            <p class="est-ayuda">{t.ayuda2}</p>
            <div class="est-opciones">
              {
                Object.keys(MONTAJE).map((id) => (
                  <label class="est-opcion">
                    <input type="radio" name="montaje" value={id} />
                    <span class="est-opcion-cuerpo">
                      <span class="est-opcion-titulo">{t.montaje[id]!.nombre}</span>
                      <span class="est-opcion-nota">{t.montaje[id]!.nota}</span>
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <!-- 3 · tamano ----------------------------------------------------- -->
          <fieldset class="est-bloque est-paso" data-paso="3">
            <legend class="est-legend">{t.paso3}</legend>
            <p class="est-ayuda">{t.ayuda3}</p>
            <div class="est-opciones">
              {
                PRESETS.map((p) => (
                  <label class="est-opcion">
                    <input
                      type="radio"
                      name="preset"
                      value={p.id}
                      data-ancho={p.ancho}
                      data-largo={p.largo}
                      checked={p.id === PRESET_POR_DEFECTO}
                    />
                    <span class="est-opcion-cuerpo">
                      <span class="est-opcion-titulo">{t.presets[p.id]!.nombre}</span>
                      <span class="est-opcion-nota">{t.presets[p.id]!.nota}</span>
                    </span>
                  </label>
                ))
              }
              <label class="est-opcion">
                <input type="radio" name="preset" value="a-medida" />
                <span class="est-opcion-cuerpo">
                  <span class="est-opcion-titulo">{t.aMedida}</span>
                </span>
              </label>
            </div>
            <div class="est-medidas">
              <label class="est-medida">
                <span>{t.ancho}</span>
                <input
                  type="number"
                  id="est-ancho"
                  name="ancho"
                  value={ANCHO_POR_DEFECTO}
                  min={MIN_FT}
                  max={MAX_FT}
                  step="1"
                  inputmode="numeric"
                />
              </label>
              <span class="est-por" aria-hidden="true">×</span>
              <label class="est-medida">
                <span>{t.largo}</span>
                <input
                  type="number"
                  id="est-largo"
                  name="largo"
                  value={LARGO_POR_DEFECTO}
                  min={MIN_FT}
                  max={MAX_FT}
                  step="1"
                  inputmode="numeric"
                />
              </label>
              <p class="est-area">
                = <strong id="est-area">{ANCHO_POR_DEFECTO * LARGO_POR_DEFECTO}</strong> {t.pies2}
              </p>
            </div>

            {/* Un deslizador por dimension. En un telefono dos campos numericos
                son dos teclados; esto es un gesto. Los campos se quedan para
                quien sabe la medida exacta. Uno por lado y no un unico pies2
                como AB: calcular() trabaja con ancho x largo, y pasar a area
                tocaria el motor de precios. Emparejado 1:1 con su campo, la
                correspondencia es biyectiva y no hace falta decidir quien manda. */}
            <div class="est-rangos">
              <input
                class="est-rango"
                type="range"
                id="est-rango-ancho"
                aria-label={t.ancho}
                value={ANCHO_POR_DEFECTO}
                min={MIN_FT}
                max={MAX_FT}
                step="1"
              />
              <input
                class="est-rango"
                type="range"
                id="est-rango-largo"
                aria-label={t.largo}
                value={LARGO_POR_DEFECTO}
                min={MIN_FT}
                max={MAX_FT}
                step="1"
              />
            </div>
            <p class="est-aviso" id="est-aviso" hidden></p>
          </fieldset>

          <!-- 4 · que hay en el suelo ---------------------------------------- -->
          <fieldset class="est-bloque est-paso" data-paso="4">
            <legend class="est-legend">{t.paso4}</legend>
            <p class="est-ayuda">{t.ayuda4}</p>
            <div class="est-opciones est-opciones--una">
              {
                ['losa-ok', 'pavers-ok', 'cesped', 'deck-madera', 'no-se'].map((id) => (
                  <label class="est-opcion">
                    <input type="radio" name="suelo" value={id} />
                    <span class="est-opcion-cuerpo">
                      <span class="est-opcion-titulo">{t.suelo[id]!.nombre}</span>
                      <span class="est-opcion-nota">{t.suelo[id]!.nota}</span>
                    </span>
                  </label>
                ))
              }
            </div>
            <!-- La subpregunta solo aparece si lo que hay debajo es cesped: no se
                 puede anclar una pergola a la tierra, asi que aqui la base deja de
                 ser opcional y pasa a ser una partida del proyecto. -->
            <div class="est-sub" id="est-sub-base" hidden>
              <p class="est-sub-titulo">{t.baseTitulo}</p>
              <p class="est-ayuda">{t.baseAyuda}</p>
              <div class="est-opciones">
                {
                  ['nueva-losa', 'nueva-pavers'].map((id) => (
                    <label class="est-opcion">
                      <input type="radio" name="base" value={id} />
                      <span class="est-opcion-cuerpo">
                        <span class="est-opcion-titulo">{t.base[id]!.nombre}</span>
                        <span class="est-opcion-nota">{t.base[id]!.nota}</span>
                        <span class="est-opcion-tarifa">
                          ${SUPERFICIES[id as 'nueva-losa'].min}–$
                          {SUPERFICIES[id as 'nueva-losa'].max}{' '}
                          <span class="est-unidad">{t.porPie}</span>
                        </span>
                      </span>
                    </label>
                  ))
                }
              </div>
            </div>
          </fieldset>

          <!-- 5 · que va debajo ---------------------------------------------- -->
          <fieldset class="est-bloque est-paso" data-paso="5">
            <legend class="est-legend">{t.paso5}</legend>
            <p class="est-ayuda">{t.ayuda5}</p>
            <div class="est-opciones est-opciones--una">
              {
                mejoras.map((m) => (
                  <label class="est-opcion">
                    <input type="checkbox" name="mejora" value={m.id} />
                    <span class="est-opcion-cuerpo">
                      <span class="est-opcion-titulo">{m.nombre}</span>
                      <span class="est-opcion-nota">{m.nota}</span>
                      <span class="est-opcion-tarifa">
                        {
                          m.tarifa ? (
                            <>
                              +${m.tarifa.min.toLocaleString('en-US')}–$
                              {m.tarifa.max.toLocaleString('en-US')}
                              {m.tarifa.techoAbierto ? '+' : ''}
                            </>
                          ) : (
                            <span class="est-unidad">{t.enLaVisita}</span>
                          )
                        }
                      </span>
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <!-- 6 · el sitio ---------------------------------------------------- -->
          <fieldset class="est-bloque est-paso" data-paso="6">
            <legend class="est-legend">{t.paso6}</legend>
            <p class="est-ayuda">{t.ayuda6}</p>

            <div class="est-medidas">
              <label class="est-medida">
                <span>{t.zip}</span>
                <input
                  type="text"
                  id="est-zip"
                  name="zip"
                  inputmode="numeric"
                  autocomplete="postal-code"
                  maxlength="5"
                  pattern="[0-9]{5}"
                />
              </label>
              <p class="est-area" id="est-condado"></p>
            </div>
            <p class="est-ayuda">{t.zipAyuda}</p>

            <p class="est-sub-titulo">{t.agua}</p>
            <p class="est-ayuda">{t.aguaAyuda}</p>
            <div class="est-opciones">
              {
                [
                  ['si', t.si],
                  ['no', t.no],
                ].map(([id, rotulo]) => (
                  <label class="est-opcion est-opcion--corta">
                    <input type="radio" name="agua" value={id} />
                    <span class="est-opcion-cuerpo">
                      <span class="est-opcion-titulo">{rotulo}</span>
                    </span>
                  </label>
                ))
              }
            </div>

            <p class="est-sub-titulo">{t.hoa}</p>
            <p class="est-ayuda">{t.hoaAyuda}</p>
            <div class="est-opciones">
              {
                [
                  ['si', t.si],
                  ['no', t.no],
                  ['no-se', t.noLoSe],
                ].map(([id, rotulo]) => (
                  <label class="est-opcion est-opcion--corta">
                    <input type="radio" name="hoa" value={id} />
                    <span class="est-opcion-cuerpo">
                      <span class="est-opcion-titulo">{rotulo}</span>
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <!-- 7 · el espejo --------------------------------------------------- -->
          <!-- No se pregunta el presupuesto: acabamos de dar el precio, y preguntar
               cuanto tiene despues de eso se lee como una trampa. Esta pregunta da
               la misma senal y ademas le entrega al comercial la objecion antes de
               la llamada. -->
          <fieldset class="est-bloque est-paso" data-paso="7">
            <legend class="est-legend">{t.paso7}</legend>
            <p class="est-ayuda">{t.ayuda7}</p>
            <div class="est-opciones est-opciones--una">
              {
                ['encaja', 'alto', 'premium'].map((id) => (
                  <label class="est-opcion">
                    <input type="radio" name="espejo" value={id} />
                    <span class="est-opcion-cuerpo">
                      <span class="est-opcion-titulo">{t.espejo[id]!.nombre}</span>
                      <span class="est-opcion-nota">{t.espejo[id]!.nota}</span>
                    </span>
                  </label>
                ))
              }
            </div>
            <!-- Si dice que es alto, se le ensenan dos palancas concretas con
                 recalculo en vivo. Recuperar el susto de precio en el sitio es mas
                 barato que perder el lead y llamarle luego. -->
            <div class="est-sub" id="est-palancas" hidden>
              <p class="est-sub-titulo">{t.palancasTitulo}</p>
              <div class="est-opciones est-opciones--una" id="est-palancas-lista"></div>
            </div>
          </fieldset>
        </form>

        <!-- 8 · el cierre ---------------------------------------------------- -->
        <!-- Hermano y no anidado: HTML no permite un <form> dentro de otro. Con
             action="/api/lead" hereda de Formulario.astro el resumen de errores
             accesible, el envio por fetch y el 303 a /thank-you cuando no hay JS. -->
        <form
          class="est-bloque est-paso est-captura"
          data-paso="8"
          id="est-captura"
          method="post"
          action="/api/lead"
          data-wf-no-turnstile
        >
          <p class="est-legend">{t.paso8}</p>
          <p class="est-ayuda">{t.ayuda8}</p>

          <input type="hidden" name="formulario" value="estimador" />
          <input type="hidden" name="pagina" value={paginaActual} />
          <input type="hidden" name="t" value="" />
          <input type="hidden" name="js" value="" />
          <div class="pp-trampa" aria-hidden="true">
            <input
              type="text"
              id="pp-website-estimador"
              name="website"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <!-- Lo que el estimador ya sabe. Lo rellena el script segun se responde:
               el endpoint acepta campos arbitrarios, asi que el embudo entero llega
               al comercial sin tocar la validacion. -->
          <input type="hidden" name="Shade-Structure" value="" />
          <input type="hidden" name="Project-Size" value="" />
          <input type="hidden" name="Mounting" value="" />
          <input type="hidden" name="Ground-Surface" value="" />
          <input type="hidden" name="New-Base" value="" />
          <input type="hidden" name="Enhancements" value="" />
          <input type="hidden" name="County" value="" />
          <input type="hidden" name="Waterfront" value="" />
          <input type="hidden" name="HOA-Approval" value="" />
          <input type="hidden" name="Budget-Fit" value="" />
          <input type="hidden" name="Estimate-Range" value="" />
          <input type="hidden" name="Estimate-Open" value="" />
          <input type="hidden" name="Steps-Completed" value="" />

          <div class="est-campos">
            <label class="est-campo">
              <span>{t.nombre}</span>
              <input type="text" name="Full-Name" autocomplete="name" required />
            </label>
            <label class="est-campo">
              <span>{t.email}</span>
              <input type="email" name="email" autocomplete="email" required />
            </label>
            <label class="est-campo">
              <span>{t.telefono}</span>
              <input type="tel" name="Phone" autocomplete="tel" required />
            </label>
            <!-- El codigo postal ya se pidio en el paso 6; este espejo es el que
                 viaja al endpoint, que lo exige. Lo rellena el script. -->
            <input type="hidden" name="ZIP-Code" value="" />
            <label class="est-consentimiento">
              <input type="checkbox" name="SMS-Consent" value="Yes" required />
              <span>{t.sms}</span>
            </label>
          </div>

          <button type="submit" class="button w-button" id="est-enviar">{t.enviar}</button>
          <p class="est-tranquilidad">{t.tranquilidad}</p>
        </form>

        <div class="est-nav" id="est-nav" hidden>
          <button type="button" class="button secundary w-button" id="est-atras">{t.atras}</button>
          <button type="button" class="button w-button" id="est-siguiente">{t.siguiente}</button>
          <button type="button" class="est-omitir" id="est-omitir">{t.noSeguro}</button>
        </div>
      </div>

      <!-- La barra movil vive DENTRO del panel a proposito: barra y hoja son un
           UNICO elemento fijo. Dos franjas fijas independientes obligan a
           coordinar sus alturas a mano y se pisan en cuanto una crece; asi el
           solape es imposible por construccion. En escritorio la barra entera
           esta en display:none y el panel sigue siendo la columna pegajosa.
           Nace plegada desde el servidor para que no haya destello. -->
      <aside class="est-panel" data-plegado>
        <div class="est-pie">
          <!-- La franja de confianza sube aqui porque es el mecanismo entero: el
               rango estrechandose con cada respuesta. Verlo no puede costar un
               toque. El texto que lo explica se queda dentro de la hoja. -->
          <div class="est-pie-confianza" aria-hidden="true"><span id="est-pie-relleno"></span></div>

          <button
            type="button"
            class="est-desplegar"
            id="est-desplegar"
            aria-expanded="false"
            aria-controls="est-resultado">
            <span class="est-pie-resumen">
              <span class="est-pie-rotulo">{t.confirmado}</span>
              {/* Plegada, .est-resultado esta en display:none y un lector de
                  pantalla no anuncia lo que no esta en el arbol: la region viva
                  es esta. ponHoja() le pone aria-hidden al desplegar, para que
                  nunca haya dos anunciando la misma cifra. */}
              <span class="est-pie-cifra" id="est-pie-total" aria-live="polite">—</span>
            </span>
            <span class="est-pie-mando">
              <span class="est-pie-accion" id="est-pie-accion">{t.cliente.verDesglose}</span>
              <svg
                class="est-pie-chevron"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"><path d="m6 15 6-6 6 6" /></svg>
            </span>
          </button>

          {/* Proxies: hacen .click() sobre los botones reales de #est-nav en vez
              de duplicar la navegacion. Toda la validacion y el salto de pasos
              siguen pasando por el mismo camino que en escritorio. */}
          <div class="est-pie-nav">
            <button type="button" class="button secundary w-button" id="est-pie-atras">{t.atras}</button>
            <button type="button" class="button w-button" id="est-pie-siguiente">{t.siguiente}</button>
          </div>
        </div>

        <div class="est-resultado" id="est-resultado" aria-live="polite">
          <p class="est-resultado-etiqueta" id="est-etiqueta">{t.confirmado}</p>
          <p class="est-resultado-cifra" id="est-total">—</p>
          <p class="est-resultado-sub" id="est-sub">{t.panelVacio}</p>
          <ul class="est-desglose" id="est-desglose"></ul>

          <!-- El segundo bloque es lo que impide que esto sea una cifra unica de
               minimo a maximo absoluto: con todo sin responder daria un rango tan
               ancho que se lee como no tener ni idea. Las partidas suben de aqui
               arriba segun se responden, y el usuario ve el techo posible desde el
               primer momento: nunca hay sorpresa. -->
          <div class="est-abierto" id="est-abierto" hidden>
            <p class="est-resultado-etiqueta">{t.porDefinir}</p>
            <p class="est-abierto-cifra" id="est-abierto-cifra"></p>
            <ul class="est-desglose" id="est-abierto-lista"></ul>
          </div>

          <div class="est-confianza" id="est-confianza" hidden>
            <div class="est-barra est-barra--panel"><span id="est-confianza-relleno"></span></div>
            <p class="est-confianza-texto" id="est-confianza-texto"></p>
          </div>
        </div>
      </aside>
    </div>

    <!-- El aviso legal vive FUERA del panel a proposito. En movil el panel es la
         barra del borde inferior, siempre a la vista mientras se responde: seis
         lineas de letra pequena ahi dentro la convertirian en media pantalla, y
         en la hoja desplegada empujarian el desglose fuera del alcance. -->
    <p class="est-legal">
      <strong>{t.legalFuerte}</strong>{t.legalAntes}
      <a href={`${base}/post/pergola-cost-south-florida`}>{t.legalEnlace}</a>{t.legalDespues}
    </p>

    <noscript>
      <div class="est-noscript">
        <h2>{t.noscriptH2}</h2>
        <table class="est-tabla">
          <thead>
            <tr><th>{t.thEstructura}</th><th>{t.thTarifa}</th></tr>
          </thead>
          <tbody>
            {
              productos.map((p) => (
                <tr>
                  <td><a href={p.href}>{p.nota}</a></td>
                  <td>
                    {
                      p.tarifa
                        ? `$${p.tarifa.min}–$${p.tarifa.max}${p.tarifa.techoAbierto ? '+' : ''}`
                        : t.aMedidaEtiqueta
                    }
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <table class="est-tabla">
          <thead>
            <tr><th>{t.thAdicion}</th><th>{t.thCoste}</th></tr>
          </thead>
          <tbody>
            {
              mejoras.map((m) => (
                <tr>
                  <td>{m.nombre}</td>
                  <td>
                    {
                      m.tarifa
                        ? `+$${m.tarifa.min.toLocaleString('en-US')}–$${m.tarifa.max.toLocaleString('en-US')}${m.tarifa.techoAbierto ? '+' : ''}`
                        : t.enLaVisita
                    }
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p>
          {t.noscriptPie}
          <a href={`${base}/contact-us/get-a-quote`}>{t.noscriptEnlace}</a>{t.noscriptFin}
        </p>
      </div>
    </noscript>
  </div>
</section>


<script is:inline set:html={`window.__ESTIMADOR__ = ${datos};`} />

<script>
  // El calculador y el stepper. El MISMO script sirve a las dos paginas: todo lo
  // que se pinta sale de `textos`, que viene del diccionario del idioma que toque.
  const D = (window as any).__ESTIMADOR__;
  const { productos, montaje, superficies, superficieMax, mejoras, condados } = D;
  const { ingenieria, waterfront, limites, textos, vocabulario } = D;

  const $ = (id: string) => document.getElementById(id)!;
  const form = $('est-form') as HTMLFormElement;
  const captura = $('est-captura') as HTMLFormElement;
  const contenedor = $('est-pasos');
  if (form && captura && contenedor) arrancar();

  function arrancar() {
    // Sin esto, un Enter en un <input type="number"> sin action haria GET a la
    // propia pagina y perderia todo lo introducido. Se corta aqui en vez de quitar
    // el <form>, que es lo que agrupa los controles para lectores de pantalla.
    form.addEventListener('submit', (e) => e.preventDefault());

    const pasos = [...contenedor.querySelectorAll<HTMLElement>('.est-paso')];
    const nav = $('est-nav');
    const atras = $('est-atras') as HTMLButtonElement;
    const siguiente = $('est-siguiente') as HTMLButtonElement;
    const omitir = $('est-omitir') as HTMLButtonElement;

    // La barra movil. Todo esto esta en display:none en escritorio, pero existe
    // siempre en el DOM: hacerlo condicional obligaria a re-hidratar al girar.
    const panel = document.querySelector('.est-panel') as HTMLElement;
    const pie = document.querySelector('.est-pie') as HTMLElement;
    const desplegar = $('est-desplegar') as HTMLButtonElement;
    const pieAtras = $('est-pie-atras') as HTMLButtonElement;
    const pieSiguiente = $('est-pie-siguiente') as HTMLButtonElement;

    /** La cifra vive en dos sitios en movil —barra plegada y hoja— y no pueden
        decir cosas distintas: un unico punto de escritura para las dos. */
    const ponCifra = (v: string) => {
      $('est-total').textContent = v;
      $('est-pie-total').textContent = v;
    };
    const ponConfianza = (pct: number) => {
      ($('est-confianza-relleno') as HTMLElement).style.width = `${pct}%`;
      ($('est-pie-relleno') as HTMLElement).style.width = `${pct}%`;
    };

    let actual = 0;
    /** Hasta donde ha llegado. Un paso solo cuenta como respondido si se paso por el. */
    let visto = 0;
    /** Los pasos que se saltaron con "no lo se": quedan en "por definir" a proposito. */
    const omitidos = new Set<number>();

    // --- persistencia ---------------------------------------------------------
    // El sello lleva la version del formulario: si manana cambian los pasos, un
    // estado guardado de la version vieja se descarta solo en vez de rellenar
    // campos que ya no significan lo mismo.
    const LLAVE = 'pp-estimador-v1';
    const guardar = () => {
      try {
        sessionStorage.setItem(
          LLAVE,
          JSON.stringify({ datos: [...new FormData(form as any)], visto, omitidos: [...omitidos] }),
        );
      } catch {
        // Modo privado de Safari y poco mas. Perder el estado no rompe nada.
      }
    };
    const recuperar = () => {
      try {
        const crudo = sessionStorage.getItem(LLAVE);
        if (!crudo) return;
        const g = JSON.parse(crudo);
        for (const [k, v] of g.datos ?? []) {
          const el = form.querySelector<HTMLInputElement>(
            `[name="${k}"][value="${CSS.escape(String(v))}"], input[name="${k}"]:not([type=radio]):not([type=checkbox])`,
          );
          if (!el) continue;
          if (el.type === 'radio' || el.type === 'checkbox') el.checked = true;
          else el.value = String(v);
        }
        visto = Number(g.visto) || 0;
        for (const n of g.omitidos ?? []) omitidos.add(Number(n));
      } catch {
        // Estado ilegible: se empieza de cero, que es lo que haria de todas formas.
      }
    };

    // --- el estado, leido del DOM --------------------------------------------
    const marcado = (n: string) =>
      form.querySelector<HTMLInputElement>(`input[name="${n}"]:checked`)?.value ?? null;
    const productoDe = () => productos.find((p: any) => p.id === marcado('producto')) ?? null;

    const lado = (input: HTMLInputElement) => {
      const n = Math.round(Number(input.value));
      if (!Number.isFinite(n)) return null;
      return Math.min(limites.max, Math.max(limites.min, n));
    };

    // --- los pasos que aplican ------------------------------------------------
    // Cabana y carport son exentas por definicion: preguntar como se apoyan seria
    // una pregunta sin respuesta posible. Solar y Sukkha no llevan tarifa, asi que
    // todo lo que hay entre el paso 1 y el cierre no cambiaria ninguna cifra.
    function aplica(indice: number) {
      const p = productoDe();
      const paso = Number(pasos[indice].dataset.paso);
      if (paso === 1 || paso === 8) return true;
      if (!p) return true;
      if (!p.tarifa) return false;
      if (paso === 2 && p.siempreExenta) return false;
      return true;
    }
    const siguienteQueAplica = (desde: number, paso: number) => {
      let i = desde + paso;
      while (i > 0 && i < pasos.length && !aplica(i)) i += paso;
      return Math.max(0, Math.min(pasos.length - 1, i));
    };

    // --- dinero ---------------------------------------------------------------
    // Se redondea a tramos de $500: un estimador que escupe $34.187 finge una
    // precision que no tiene. El minimo baja y el maximo sube, nunca al reves.
    const aTramo = (n: number, arriba: boolean) =>
      (arriba ? Math.ceil(n / 500) : Math.floor(n / 500)) * 500;
    const dinero = (n: number) => '$' + n.toLocaleString('en-US');
    const banda = (min: number, max: number, abierto: boolean) =>
      `${dinero(aTramo(min, false))} – ${dinero(aTramo(max, true))}${abierto ? '+' : ''}`;

    interface Partida {
      etiqueta: string;
      min: number;
      max: number;
      abierto: boolean;
      firme: boolean;
      /** Se valora en la visita: suma cero y se dice en voz alta. */
      enVisita?: boolean;
    }

    // --- el calculo -----------------------------------------------------------
    //
    // Todo el proyecto es una suma de partidas con [min, max]. Lo que aun no se ha
    // respondido aporta su banda COMPLETA; responderlo la colapsa. Por eso el rango
    // se estrecha solo, por matematica y no por animacion: no hay nada que fingir.
    function calcular(): { firmes: Partida[]; abiertas: Partida[]; preguntas: boolean[] } {
      const firmes: Partida[] = [];
      const abiertas: Partida[] = [];
      const preguntas: boolean[] = [];
      const mete = (p: Partida) => (p.firme ? firmes : abiertas).push(p);

      const p = productoDe();
      if (!p || !p.tarifa) return { firmes, abiertas, preguntas };

      const ancho = lado($('est-ancho') as HTMLInputElement);
      const largo = lado($('est-largo') as HTMLInputElement);
      if (ancho === null || largo === null) return { firmes, abiertas, preguntas };
      const area = ancho * largo;

      // 1 · estructura. SIEMPRE firme en cuanto hay producto y medidas: el coste de
      //     la estructura se conoce. Lo unico que aporta saber como se apoya es un
      //     8% —adosada 0,92 contra exenta 1,00— y eso ensancha la banda de esta
      //     partida, no la deja sin confirmar. Tratarla como abierta hacia que el
      //     panel dijera "confirmado: $0" con una pergola ya elegida, que es falso
      //     y ademas es justo lo contrario de lo que el panel viene a hacer.
      const m = p.siempreExenta ? 'exenta' : marcado('montaje');
      const fMin = m ? montaje[m] : montaje.adosada;
      const fMax = m ? montaje[m] : montaje.exenta;
      preguntas.push(!!m);
      mete({
        etiqueta: `${p.nombre} · ${area} ${textos.pies2}`,
        min: area * p.tarifa.min * fMin,
        max: area * p.tarifa.max * fMax,
        abierto: p.tarifa.techoAbierto,
        firme: true,
      });

      // 2 · el suelo. La banda mas grande mientras no se responde, porque incluye
      //     la posibilidad de tener que construir la base entera.
      const suelo = marcado('suelo');
      const base = marcado('base');
      const puesta = (k: string) => superficies[k] ?? { min: 0, max: 0 };
      preguntas.push(suelo === 'cesped' ? !!base : !!suelo && suelo !== 'no-se');
      if (suelo === 'losa-ok' || suelo === 'pavers-ok') {
        mete({ etiqueta: textos.partidaBase, min: 0, max: 0, abierto: false, firme: true });
      } else if (suelo === 'cesped' && base) {
        const s = puesta(base);
        mete({
          etiqueta: textos.partidaBase,
          min: area * s.min,
          max: area * s.max,
          abierto: false,
          firme: true,
        });
      } else if (suelo === 'deck-madera') {
        const s = puesta('deck-madera');
        mete({
          etiqueta: textos.partidaBase,
          min: area * s.min,
          max: area * s.max,
          abierto: false,
          firme: false,
        });
      } else {
        mete({
          etiqueta: textos.partidaBase,
          min: 0,
          max: area * superficieMax,
          abierto: false,
          firme: false,
        });
      }

      // 3 · calculo y permisos. El codigo postal no aporta un numero nuevo: dice
      //     donde de la banda publicada cae la jurisdiccion.
      const zip = ($('est-zip') as HTMLInputElement)?.value ?? '';
      const n = Number(String(zip).trim().slice(0, 5));
      const c = Number.isInteger(n)
        ? condados.find((x: any) => n >= x.desde && n <= x.hasta)
        : undefined;
      preguntas.push(!!c);
      mete({
        etiqueta: textos.partidaIngenieria,
        min: c ? c.min : ingenieria.min,
        max: c ? c.max : ingenieria.max,
        abierto: !c,
        firme: !!c,
      });

      // 4 · frente al agua.
      const agua = marcado('agua');
      preguntas.push(!!agua);
      mete({
        etiqueta: textos.partidaAgua,
        min: agua === 'si' ? waterfront.min : 0,
        max: agua === 'no' ? 0 : waterfront.max,
        abierto: false,
        firme: !!agua,
      });

      // 5 · mejoras. Las que comparten grupo aportan su banda UNA vez: la guia
      //     publicada precia iluminacion y ventiladores juntos, asi que marcarlas
      //     las dos no puede cobrar dos veces.
      const elegidas = [...form.querySelectorAll<HTMLInputElement>('input[name="mejora"]:checked')];
      const paso5Visto = visto >= indiceDePaso(5);
      preguntas.push(paso5Visto);
      if (elegidas.length) {
        const grupos = new Set<string>();
        let min = 0;
        let max = 0;
        let abierto = false;
        const nombres: string[] = [];
        let hayVisita = false;
        for (const el of elegidas) {
          const mj = mejoras.find((x: any) => x.id === el.value);
          if (!mj) continue;
          nombres.push(mj.nombre);
          if (!mj.tarifa) {
            hayVisita = true;
            continue;
          }
          if (mj.grupo) {
            if (grupos.has(mj.grupo)) continue;
            grupos.add(mj.grupo);
          }
          min += mj.tarifa.min;
          max += mj.tarifa.max;
          abierto = abierto || mj.tarifa.techoAbierto;
        }
        mete({
          etiqueta: `${textos.partidaMejoras} · ${nombres.length}`,
          min,
          max,
          abierto,
          firme: true,
          enVisita: hayVisita,
        });
      } else if (!paso5Visto) {
        // Sin haber llegado al paso, el techo es que las quiera todas.
        let max = 0;
        const grupos = new Set<string>();
        for (const mj of mejoras) {
          if (!mj.tarifa) continue;
          if (mj.grupo) {
            if (grupos.has(mj.grupo)) continue;
            grupos.add(mj.grupo);
          }
          max += mj.tarifa.max;
        }
        mete({ etiqueta: textos.partidaMejoras, min: 0, max, abierto: false, firme: false });
      }

      return { firmes, abiertas, preguntas };
    }

    const indiceDePaso = (n: number) => pasos.findIndex((p) => Number(p.dataset.paso) === n);

    // --- pintar el panel ------------------------------------------------------
    function pintarPanel() {
      const { firmes, abiertas, preguntas } = calcular();
      const p = productoDe();

      const elSub = $('est-sub');
      const elDesglose = $('est-desglose');
      const elAbierto = $('est-abierto');
      const elConfianza = $('est-confianza');

      // Antes de elegir nada el panel no puede quedarse en un guion dentro de una
      // caja navy vacia: ocupa media pantalla y no dice que hacer. Lleva la frase
      // que explica que va a pasar ahi.
      if (!p || !p.tarifa) {
        ponCifra('—');
        elSub.textContent = p ? textos.soloCotizacion : textos.panelVacio;
        elDesglose.replaceChildren();
        elAbierto.hidden = true;
        elConfianza.hidden = true;
        ponConfianza(0);
        return;
      }

      const suma = (l: Partida[], k: 'min' | 'max') => l.reduce((a, x) => a + x[k], 0);
      const abiertoFirme = firmes.some((x) => x.abierto);

      ponCifra(banda(suma(firmes, 'min'), suma(firmes, 'max'), abiertoFirme));

      const ancho = lado($('est-ancho') as HTMLInputElement) ?? 0;
      const largo = lado($('est-largo') as HTMLInputElement) ?? 0;
      elSub.textContent =
        `${p.nombre} · ${ancho} × ${largo} ${textos.pies} · ${ancho * largo} ${textos.instalados}`;

      // Los <li> los crea el JS, asi que nunca reciben el data-astro-cid del scoping:
      // el CSS que los pinta necesita :global(). Sin eso el texto cae a #333 sobre el
      // panel navy — 1,56:1 de contraste, ilegible.
      const fila = (p2: Partida) => {
        const li = document.createElement('li');
        const a = document.createElement('span');
        a.textContent = p2.etiqueta;
        const b = document.createElement('span');
        b.textContent = p2.enVisita && !p2.max
          ? textos.enLaVisita
          : banda(p2.min, p2.max, p2.abierto);
        li.append(a, b);
        return li;
      };
      elDesglose.replaceChildren(...firmes.map(fila));

      if (abiertas.length) {
        elAbierto.hidden = false;
        $('est-abierto-cifra').textContent =
          '~' + banda(suma(abiertas, 'min'), suma(abiertas, 'max'), abiertas.some((x) => x.abierto));
        $('est-abierto-lista').replaceChildren(...abiertas.map(fila));
      } else {
        elAbierto.hidden = true;
      }

      // La confianza cuenta PREGUNTAS respondidas, no partidas cerradas. Si contara
      // partidas, responder el montaje no moveria la barra —solo estrecha una banda
      // que ya estaba firme— y el usuario veria que responder no sirve de nada.
      const pct = preguntas.length
        ? Math.round((preguntas.filter(Boolean).length / preguntas.length) * 100)
        : 0;
      elConfianza.hidden = false;
      ponConfianza(pct);
      const hueco = suma(abiertas, 'max') - suma(abiertas, 'min');
      $('est-confianza-texto').textContent = abiertas.length
        ? textos.estrecha
            .replaceAll('{n}', String(abiertas.length))
            .replaceAll('{monto}', dinero(aTramo(hueco, true)))
        : textos.cerrado;

      volcarAlFormulario(firmes, abiertas);
    }

    // --- lo que viaja al comercial -------------------------------------------
    // El endpoint acepta campos arbitrarios, asi que el embudo entero llega sin
    // tocar la validacion. Dos limites reales: 256 caracteres por campo, y ningun
    // salto de linea salvo en un campo que se llame literalmente `Message`.
    function volcarAlFormulario(firmes: Partida[], abiertas: Partida[]) {
      const pon = (n: string, v: string) => {
        const el = captura.querySelector<HTMLInputElement>(`input[name="${n}"]`);
        if (el) el.value = v.slice(0, 250);
      };
      const p = productoDe();
      const ancho = lado($('est-ancho') as HTMLInputElement) ?? 0;
      const largo = lado($('est-largo') as HTMLInputElement) ?? 0;
      const zip = (($('est-zip') as HTMLInputElement)?.value ?? '').trim();
      const n = Number(zip.slice(0, 5));
      const c = Number.isInteger(n)
        ? condados.find((x: any) => n >= x.desde && n <= x.hasta)
        : undefined;
      const nombres = [...form.querySelectorAll<HTMLInputElement>('input[name="mejora"]:checked')]
        .map((el) => mejoras.find((x: any) => x.id === el.value)?.id)
        .filter(Boolean);
      const suma = (l: Partida[], k: 'min' | 'max') => l.reduce((a, x) => a + x[k], 0);

      /** El `id` interno traducido al vocabulario del despacho. */
      const dicho = (campo: string) => {
        const v = marcado(campo);
        return v ? (vocabulario[campo]?.[v] ?? v) : '';
      };

      pon('Shade-Structure', p?.lead ?? '');
      pon('Project-Size', p ? `${ancho} x ${largo} ft · ${ancho * largo} sq ft` : '');
      pon('Mounting', p?.siempreExenta ? vocabulario.montaje.exenta : dicho('montaje'));
      pon('Ground-Surface', dicho('suelo'));
      pon('New-Base', dicho('base'));
      pon('Enhancements', nombres.join(' · '));
      pon('ZIP-Code', zip);
      pon('County', c?.id ?? '');
      pon('Waterfront', dicho('agua'));
      pon('HOA-Approval', dicho('hoa'));
      pon('Budget-Fit', dicho('espejo'));
      pon(
        'Estimate-Range',
        p?.tarifa ? banda(suma(firmes, 'min'), suma(firmes, 'max'), firmes.some((x) => x.abierto)) : '',
      );
      pon(
        'Estimate-Open',
        abiertas.length
          ? banda(suma(abiertas, 'min'), suma(abiertas, 'max'), false) + ` (${abiertas.length})`
          : '',
      );
      pon('Steps-Completed', String(visto + 1));
    }

    // --- el area, el recorte y la subpregunta --------------------------------
    function pintarPasoActual() {
      const ancho = lado($('est-ancho') as HTMLInputElement);
      const largo = lado($('est-largo') as HTMLInputElement);
      const elAviso = $('est-aviso');

      if (ancho === null || largo === null) {
        elAviso.textContent = textos.pideMedidas;
        elAviso.hidden = false;
      } else {
        $('est-area').textContent = String(ancho * largo);
        // La vuelta del deslizador. El campo manda —es el que calcular() lee— y
        // el rango le sigue; asi el preset, el teclado y el gesto acaban siempre
        // en el mismo sitio sin tener que decidir quien tiene la razon.
        // Salvo el que se esta arrastrando: reescribirle el valor bajo el dedo
        // es pelearse con el usuario.
        for (const [id, v] of [['est-rango-ancho', ancho], ['est-rango-largo', largo]] as const) {
          const el = $(id) as HTMLInputElement;
          if (document.activeElement !== el) el.value = String(v);
        }
        // Se avisa en vez de reescribir el input bajo los dedos de quien escribe.
        const recortado =
          Number(($('est-ancho') as HTMLInputElement).value) !== ancho
          || Number(($('est-largo') as HTMLInputElement).value) !== largo;
        elAviso.textContent = recortado
          ? textos.recorte
              .replaceAll('{ancho}', String(ancho))
              .replaceAll('{largo}', String(largo))
              .replaceAll('{min}', String(limites.min))
              .replaceAll('{max}', String(limites.max))
          : '';
        elAviso.hidden = !recortado;
      }

      $('est-sub-base').hidden = marcado('suelo') !== 'cesped';

      const zip = (($('est-zip') as HTMLInputElement)?.value ?? '').trim();
      const n = Number(zip.slice(0, 5));
      const c = Number.isInteger(n)
        ? condados.find((x: any) => n >= x.desde && n <= x.hasta)
        : undefined;
      $('est-condado').textContent = zip.length === 5 && !c ? '—' : c ? c.id : '';

      $('est-palancas').hidden = marcado('espejo') !== 'alto';
    }

    // --- navegacion -----------------------------------------------------------
    function pintar() {
      pasos.forEach((el, i) => (el.hidden = i !== actual));
      const total = pasos.filter((_, i) => aplica(i)).length;
      const hechos = pasos.filter((_, i) => aplica(i) && i <= actual).length;
      $('est-progreso').hidden = false;
      $('est-nav').hidden = false;
      (atras as HTMLElement).hidden = actual === 0;
      (siguiente as HTMLElement).hidden = actual === pasos.length - 1;
      // El enlace de escape no aparece ni en el primer paso —sin producto no hay
      // nada que estimar— ni en el cierre, que no es una pregunta.
      (omitir as HTMLElement).hidden = actual === 0 || actual === pasos.length - 1;
      // Los proxy de la barra espejan a los reales en vez de recalcular la
      // condicion: una segunda copia de la regla es una copia que un dia dira otra cosa.
      pieAtras.hidden = (atras as HTMLElement).hidden;
      // El cierre es el unico paso sin "siguiente", y dejarlo sin accion primaria
      // en la barra seria quitar el boton justo en el paso que convierte: alli el
      // proxy apunta a #est-enviar. El rotulo se copia del boton real para que no
      // haya una segunda traduccion que un dia diga otra cosa.
      pieSiguiente.textContent = primario().textContent;
      medirPie();
      ($('est-barra-relleno') as HTMLElement).style.width = `${Math.round((hechos / total) * 100)}%`;
      $('est-progreso-texto').textContent = textos.dePaso
        .replaceAll('{n}', String(hechos))
        .replaceAll('{total}', String(total));
    }

    function ir(delta: number) {
      const destino = siguienteQueAplica(actual, delta);
      if (destino === actual) return;
      actual = destino;
      visto = Math.max(visto, actual);
      pintar();
      pintarPasoActual();
      pintarPanel();
      guardar();
      // :not([type=hidden]) no es cosmetico: el primer input del paso 8 es uno de
      // los 13 ocultos del embudo y .focus() sobre el es un no-op, asi que el foco
      // se quedaba donde estuviera. Mismo selector que Formulario.astro:253.
      pasos[actual]
        .querySelector<HTMLElement>('input:not([type="hidden"]), select, textarea, button')
        ?.focus();
      pasos[actual].scrollIntoView({ block: 'nearest' });
    }

    atras.addEventListener('click', () => ir(-1));
    siguiente.addEventListener('click', () => ir(1));
    omitir.addEventListener('click', () => {
      omitidos.add(actual);
      ir(1);
    });

    // --- la barra movil ------------------------------------------------------
    /** Lo que hace avanzar desde el paso actual: navegar, o enviar en el cierre. */
    const primario = () =>
      actual === pasos.length - 1 ? ($('est-enviar') as HTMLButtonElement) : siguiente;

    const ponHoja = (abierta: boolean) => {
      panel.toggleAttribute('data-plegado', !abierta);
      desplegar.setAttribute('aria-expanded', String(abierta));
      $('est-pie-accion').textContent = abierta ? textos.ocultarDesglose : textos.verDesglose;
      // Desplegada manda el panel, que ya es aria-live. Si la barra siguiera
      // anunciando, un lector de pantalla leeria la misma cifra dos veces.
      $('est-pie-total').setAttribute('aria-hidden', String(abierta));
      medirPie();
    };
    desplegar.addEventListener('click', () => ponHoja(panel.hasAttribute('data-plegado')));

    // Cerrar ANTES de navegar: si no, el paso nuevo aparece detras de la hoja.
    // Los proxy no repiten la navegacion, la delegan: .click() sobre el boton
    // real hace que validacion y salto de pasos sigan el camino de escritorio.
    pieAtras.addEventListener('click', () => {
      ponHoja(false);
      atras.click();
    });
    pieSiguiente.addEventListener('click', () => {
      ponHoja(false);
      primario().click();
    });

    // El hueco que libera el contenido tapado sale de la barra REAL, no de una
    // constante: la barra crece si el rotulo se parte en dos lineas, si el
    // sistema sube el tamano de fuente o si el telefono gira. Si la barra esta
    // en display:none (escritorio) mide 0 y se deja el valor de la hoja.
    const est = document.querySelector('.est') as HTMLElement;
    /** El hueco que .est-pasos reserva para no quedar debajo de la barra. */
    const medirPie = () => {
      const alto = pie?.offsetHeight ?? 0;
      // 0 = barra en display:none (escritorio): ahi el suelo de la hoja vale.
      if (alto && est) est.style.setProperty('--alto-pie', `${alto}px`);
    };
    // Se llama a mano en los dos momentos en que la barra puede cambiar de alto
    // —cambio de paso, que reescribe el rotulo del boton, y plegar/desplegar— y
    // ademas se observa, que es lo unico que cubre girar el telefono o subir el
    // tamano de fuente del sistema. A mano primero: un observador que no dispara
    // deja el hueco corto y el contenido debajo de la barra, y eso no se ve.
    if (pie && 'ResizeObserver' in window) new ResizeObserver(medirPie).observe(pie);
    // Y cuando la tipografia real sustituye a la de respaldo: hasta ese momento
    // los rotulos miden otra cosa y el hueco se calcula corto.
    document.fonts?.ready.then(medirPie);

    // iOS ancla position:fixed al layout viewport, que no encoge al abrir el
    // teclado: la barra quedaria dibujada DEBAJO de las teclas, y como los
    // botones reales estan ocultos en movil no habria forma de avanzar sin
    // cerrarlo primero. visualViewport si mide lo que queda a la vista.
    const vv = window.visualViewport;
    if (vv) {
      const ajustaTeclado = () => {
        const tapado = Math.max(0, window.innerHeight - vv.height - vv.offsetTop);
        panel.style.setProperty('--alto-teclado', `${Math.round(tapado)}px`);
      };
      vv.addEventListener('resize', ajustaTeclado);
      vv.addEventListener('scroll', ajustaTeclado);
      ajustaTeclado();
    }
    window.addEventListener('resize', medirPie);

    // Una barra fija sin condicion de salida se queda pegada sobre las resenas y
    // el pie hasta el final de la pagina; el sticky de antes se soltaba solo al
    // acabar su bloque. Esto le devuelve ese final.
    if (est && 'IntersectionObserver' in window) {
      new IntersectionObserver(([e]) =>
        panel.toggleAttribute('data-fuera', !e.isIntersecting),
      ).observe(est);
    }

    // Rango -> campo. Escribir .value no dispara ningun evento, asi que el preset
    // "a medida" se marca aqui a mano igual que hace el camino del teclado; el
    // input del propio rango si burbujea al form, que ya recalcula y guarda.
    for (const [rango, campo] of [
      ['est-rango-ancho', 'est-ancho'],
      ['est-rango-largo', 'est-largo'],
    ]) {
      $(rango).addEventListener('input', () => {
        ($(campo) as HTMLInputElement).value = ($(rango) as HTMLInputElement).value;
        const aMedida = form.querySelector<HTMLInputElement>('input[name="preset"][value="a-medida"]');
        if (aMedida) aMedida.checked = true;
      });
    }

    // Elegir producto en el paso 1 avanza solo: es una decision, no un formulario.
    form.addEventListener('change', (e) => {
      const el = e.target as HTMLInputElement;
      if (el.name === 'preset' && el.value !== 'a-medida') {
        ($('est-ancho') as HTMLInputElement).value = el.dataset.ancho ?? '';
        ($('est-largo') as HTMLInputElement).value = el.dataset.largo ?? '';
      }
      if (el.name === 'ancho' || el.name === 'largo') {
        const aMedida = form.querySelector<HTMLInputElement>('input[name="preset"][value="a-medida"]');
        if (aMedida) aMedida.checked = true;
      }
      pintarPasoActual();
      pintarPanel();
      guardar();
    });
    form.addEventListener('input', () => {
      pintarPasoActual();
      pintarPanel();
      guardar();
    });

    recuperar();
    pintar();
    pintarPasoActual();
    pintarPanel();
  }
</script>

