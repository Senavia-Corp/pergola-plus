---
import type { TextosEstimador } from '../i18n/estimador';

// Estimador de presupuesto. CODIGO DE AUTORIA PROPIA.
//
// Vive en un componente y no en la pagina porque hay DOS paginas —/project-estimator
// y /es/project-estimator— y los precios no pueden estar duplicados. Lo que cambia
// entre idiomas son los rotulos y los enlaces internos; las tarifas son las mismas y
// se declaran una sola vez, aqui.
//
// Se maqueta con las mismas clases que el resto del sitio (.header-page / .container
// / .body-page / .call-to-action-footer) para que no se note la costura, y lo propio
// del estimador va en el <style> de abajo.
//
// Sin wfPage/wfSite a proposito: `data-wf-page` solo lo consulta IX2 para ids con
// delimitador "|" (page-scoped), y ninguno de los 4 del footer ni de los 18 del nav
// lo lleva, asi que sus animaciones funcionan igual. Esta pagina no tiene
// interacciones propias, asi que tampoco necesita bloque anti-FOUC.

// -----------------------------------------------------------------------------
// PRECIOS
// -----------------------------------------------------------------------------
// TODO dato de aqui sale de la guia de costes publicada por la propia empresa,
// /post/pergola-cost-south-florida ("Average Pergola Cost in South Florida
// (2026)"), y coincide con /post/aluminum-pergola-cost-boca-raton-vs-fort-lauderdale.
// No hay ni un numero inventado: si el cliente actualiza sus tarifas, se
// actualizan las dos tablas de abajo y ya — las DOS paginas leen de aqui.
//
// El "+" del articulo ($150+, $175+) significa que el techo es abierto; se
// arrastra hasta el resultado para no dar una cifra maxima que no es tal.

const TARIFAS = [
  { id: 'open-air',  min: 85,  max: 110, techoAbierto: false, href: '/products/open-air-pergolas' },
  { id: 'insulated', min: 95,  max: 130, techoAbierto: false, href: '/products/solid-roof-pergolas' },
  { id: 'louvered',  min: 110, max: 150, techoAbierto: true,  href: '/products/motorized-louvered-pergolas' },
  { id: 'cabana',    min: 120, max: 175, techoAbierto: true,  href: '/products/cabanas' },
];

const EXTRAS_TARIFAS = [
  { id: 'engineering', min: 2000, max: 5000,  techoAbierto: true },
  { id: 'footings',    min: 3000, max: 10000, techoAbierto: true },
  { id: 'electrical',  min: 1000, max: 4000,  techoAbierto: true },
  { id: 'waterfront',  min: 5000, max: 15000, techoAbierto: false },
];

// Medidas por defecto: 16 x 20 ft = 320 sq ft, un tamano corriente de patio.
const ANCHO_POR_DEFECTO = 16;
const LARGO_POR_DEFECTO = 20;

interface Props {
  t: TextosEstimador;
  /** '' en ingles, '/es' en español. Prefijo de los enlaces internos. */
  base?: string;
}
const { t, base = '' } = Astro.props;

const ESTRUCTURAS = TARIFAS.map((e) => ({ ...e, ...t.estructuras[e.id]!, href: base + e.href }));
const EXTRAS = EXTRAS_TARIFAS.map((x) => ({ ...x, ...t.extras[x.id]! }));

// El dinero se formatea SIEMPRE en en-US, tambien en la version española: son
// dolares en Florida, y "$34,000" es como los escribe y los lee ahi todo el mundo.
// Con es-ES saldria "$34.000", que a un vecino de Hialeah le parece otra cifra.
const datos = JSON.stringify({
  estructuras: ESTRUCTURAS.map(({ id, nombre, min, max, techoAbierto }) => ({ id, nombre, min, max, techoAbierto })),
  extras: EXTRAS.map(({ id, nombre, min, max, techoAbierto }) => ({ id, nombre, min, max, techoAbierto })),
  textos: t.cliente,
});
---

<header class="header-page">
  <div class="w-layout-blockcontainer container w-container">
    <div class="wrapper-hero-page">
      <h1>{t.h1}</h1>
      <div>{t.entradilla}</div>
    </div>
  </div>
</header>

<section class="body-page">
  <div class="w-layout-blockcontainer container w-container">
    <div class="est">
      <form class="est-form" id="est-form" novalidate>
        <fieldset class="est-bloque">
          <legend class="est-legend">{t.paso1}</legend>
          <div class="est-opciones">
            {ESTRUCTURAS.map((e, i) => (
              <label class="est-opcion">
                <input type="radio" name="estructura" value={e.id} checked={i === 0} />
                <span class="est-opcion-cuerpo">
                  <span class="est-opcion-titulo">{e.nombre}</span>
                  <span class="est-opcion-nota">{e.nota}</span>
                  <span class="est-opcion-tarifa">
                    ${e.min}–${e.max}{e.techoAbierto ? '+' : ''} <span class="est-unidad">{t.porPie}</span>
                  </span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="est-bloque">
          <legend class="est-legend">{t.paso2}</legend>
          <div class="est-medidas">
            <label class="est-medida">
              <span>{t.ancho}</span>
              <input type="number" id="est-ancho" name="ancho" value={ANCHO_POR_DEFECTO}
                     min="8" max="60" step="1" inputmode="numeric" />
            </label>
            <span class="est-por" aria-hidden="true">×</span>
            <label class="est-medida">
              <span>{t.largo}</span>
              <input type="number" id="est-largo" name="largo" value={LARGO_POR_DEFECTO}
                     min="8" max="60" step="1" inputmode="numeric" />
            </label>
            <p class="est-area">= <strong id="est-area">{ANCHO_POR_DEFECTO * LARGO_POR_DEFECTO}</strong> {t.pies2}</p>
          </div>
          <p class="est-aviso" id="est-aviso" hidden></p>
        </fieldset>

        <fieldset class="est-bloque">
          <legend class="est-legend">{t.paso3}</legend>
          <p class="est-ayuda">{t.ayudaExtras}</p>
          <div class="est-opciones est-opciones--extras">
            {EXTRAS.map((x) => (
              <label class="est-opcion">
                <input type="checkbox" name="extra" value={x.id} />
                <span class="est-opcion-cuerpo">
                  <span class="est-opcion-titulo">{x.nombre}</span>
                  <span class="est-opcion-nota">{x.nota}</span>
                  <span class="est-opcion-tarifa">
                    +${x.min.toLocaleString('en-US')}–${x.max.toLocaleString('en-US')}{x.techoAbierto ? '+' : ''}
                  </span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>
      </form>

      <aside class="est-panel">
        <div class="est-resultado" aria-live="polite">
          <p class="est-resultado-etiqueta">{t.resultado}</p>
          <p class="est-resultado-cifra" id="est-total">—</p>
          <p class="est-resultado-sub" id="est-sub"></p>
          <ul class="est-desglose" id="est-desglose"></ul>
        </div>

        <p class="est-legal">
          <strong>{t.legalFuerte}</strong> {t.legalAntes}
          <a href="/post/pergola-cost-south-florida">{t.legalEnlace}</a>{t.legalDespues}
        </p>

        <div class="est-cta">
          <a href={`${base}/contact-us/get-a-quote`} class="button w-button">{t.ctaExacto}</a>
          <a href={`${base}/contact-us/schedule-a-visit`} class="button secundary w-button">{t.ctaVisita}</a>
        </div>
      </aside>
    </div>

    <noscript>
      <div class="est-noscript">
        <h2>{t.noscriptH2}</h2>
        <table class="est-tabla">
          <thead><tr><th>{t.thEstructura}</th><th>{t.thTarifa}</th></tr></thead>
          <tbody>
            {ESTRUCTURAS.map((e) => (
              <tr><td><a href={e.href}>{e.nombre}</a></td><td>${e.min}–${e.max}{e.techoAbierto ? '+' : ''}</td></tr>
            ))}
          </tbody>
        </table>
        <table class="est-tabla">
          <thead><tr><th>{t.thAdicion}</th><th>{t.thCoste}</th></tr></thead>
          <tbody>
            {EXTRAS.map((x) => (
              <tr><td>{x.nombre}</td><td>${x.min.toLocaleString('en-US')}–${x.max.toLocaleString('en-US')}{x.techoAbierto ? '+' : ''}</td></tr>
            ))}
          </tbody>
        </table>
        <p>{t.noscriptPie} <a href={`${base}/contact-us/get-a-quote`}>{t.noscriptEnlace}</a>{t.noscriptFin}</p>
      </div>
    </noscript>
  </div>
</section>

<section class="call-to-action-footer">
  <div class="wrapper-call-to-action">
    <div class="box-call-to-action">
      <h2>{t.cierreH2}</h2>
      <div>{t.cierreP}</div>
      <div class="process-cta">
        <a href={`${base}/contact-us/get-a-quote`} class="button w-button">{t.cierreA}</a>
        <a href={`${base}/contact-us/schedule-a-visit`} class="button secundary w-button">{t.cierreB}</a>
      </div>
    </div>
  </div>
  <img
    sizes="(max-width: 2000px) 100vw, 2000px"
    srcset="/images/luxury-outdoor-living-south-florida-pool-pergola-outdoor-kitchen-modern-backyard-p-500.avif 500w, /images/luxury-outdoor-living-south-florida-pool-pergola-outdoor-kitchen-modern-backyard-p-800.avif 800w, /images/luxury-outdoor-living-south-florida-pool-pergola-outdoor-kitchen-modern-backyard-p-1080.avif 1080w, /images/luxury-outdoor-living-south-florida-pool-pergola-outdoor-kitchen-modern-backyard.avif 2000w"
    alt={t.altCierre}
    src="/images/luxury-outdoor-living-south-florida-pool-pergola-outdoor-kitchen-modern-backyard.avif"
    loading="lazy"
    class="image-call-to-action"
  />
</section>

<script is:inline set:html={`window.__ESTIMADOR__ = ${datos};`} />

<script>
  // Estimador. Vanilla, sin dependencias: son cuatro multiplicaciones.
  //
  // Los rotulos que pinta el cliente llegan por `textos` dentro de __ESTIMADOR__,
  // no cableados aqui: es el mismo script en las dos paginas.
  const { estructuras, extras, textos } = (window as any).__ESTIMADOR__;

  const $ = (id: string) => document.getElementById(id)!;
  const form = $('est-form') as HTMLFormElement;

  // Este <form> no envia nada: es una calculadora y el resultado se pinta al
  // vuelo. Pero sigue siendo un <form> con dos <input type="number">, y sin action
  // un Enter en cualquiera de los dos hace un GET a la propia pagina: recarga y se
  // pierde lo que el visitante habia metido. Se corta aqui en vez de quitar el
  // <form>, porque el <form> es lo que agrupa los controles y da la validacion.
  form.addEventListener('submit', (e) => e.preventDefault());
  const inAncho = $('est-ancho') as HTMLInputElement;
  const inLargo = $('est-largo') as HTMLInputElement;
  const elArea = $('est-area');
  const elTotal = $('est-total');
  const elSub = $('est-sub');
  const elDesglose = $('est-desglose');
  const elAviso = $('est-aviso');

  const MIN_FT = 8, MAX_FT = 60;

  // Se redondea a la baja/alza en tramos de 500: un estimador que escupe
  // "$34.187" finge una precision que no tiene.
  const aTramo = (n: number, arriba: boolean) =>
    (arriba ? Math.ceil(n / 500) : Math.floor(n / 500)) * 500;

  // en-US tambien en español: ver el comentario del frontmatter.
  const dinero = (n: number) => '$' + n.toLocaleString('en-US');

  function lado(input: HTMLInputElement) {
    const n = Math.round(Number(input.value));
    if (!Number.isFinite(n)) return null;
    return Math.min(MAX_FT, Math.max(MIN_FT, n));
  }

  function calcular() {
    const ancho = lado(inAncho);
    const largo = lado(inLargo);

    if (ancho === null || largo === null) {
      elAviso.textContent = textos.pideMedidas;
      elAviso.hidden = false;
      elTotal.textContent = '—';
      elSub.textContent = '';
      elDesglose.replaceChildren();
      return;
    }

    // Se avisa del recorte en vez de corregir el input mientras se escribe:
    // reescribir el valor bajo los dedos del usuario es de las cosas mas
    // molestas que puede hacer un formulario.
    const recortado = Number(inAncho.value) !== ancho || Number(inLargo.value) !== largo;
    elAviso.textContent = recortado
      ? textos.recorte
          .replace('{ancho}', String(ancho))
          .replace('{largo}', String(largo))
          .replace('{min}', String(MIN_FT))
          .replace('{max}', String(MAX_FT))
      : '';
    elAviso.hidden = !recortado;

    const area = ancho * largo;
    elArea.textContent = String(area);

    const elegida = estructuras.find(
      (e: any) => e.id === (form.querySelector('input[name="estructura"]:checked') as HTMLInputElement)?.value
    ) ?? estructuras[0];

    let min = area * elegida.min;
    let max = area * elegida.max;
    let abierto = elegida.techoAbierto;

    const filas = [{
      etiqueta: `${elegida.nombre} · ${area} ${textos.pies2}`,
      texto: `${dinero(aTramo(min, false))}–${dinero(aTramo(max, true))}${elegida.techoAbierto ? '+' : ''}`,
    }];

    for (const cb of form.querySelectorAll<HTMLInputElement>('input[name="extra"]:checked')) {
      const x = extras.find((e: any) => e.id === cb.value);
      if (!x) continue;
      min += x.min;
      max += x.max;
      abierto = abierto || x.techoAbierto;
      filas.push({ etiqueta: x.nombre, texto: `+${dinero(x.min)}–${dinero(x.max)}${x.techoAbierto ? '+' : ''}` });
    }

    elTotal.textContent = `${dinero(aTramo(min, false))} – ${dinero(aTramo(max, true))}${abierto ? '+' : ''}`;
    elSub.textContent = `${elegida.nombre} · ${ancho} × ${largo} ${textos.pies} · ${area} ${textos.instalados}`;

    elDesglose.replaceChildren(...filas.map((f) => {
      const li = document.createElement('li');
      const a = document.createElement('span'); a.textContent = f.etiqueta;
      const b = document.createElement('span'); b.textContent = f.texto;
      li.append(a, b);
      return li;
    }));
  }

  form.addEventListener('input', calcular);
  form.addEventListener('change', calcular);
  calcular();
</script>

<style> de abajo.
//
// Sin wfPage/wfSite a proposito: `data-wf-page` solo lo consulta IX2 para ids
// con delimitador "|" (page-scoped), y ninguno de los 4 del footer ni de los 18
// del nav lo lleva, asi que sus animaciones funcionan igual. Esta pagina no
// tiene interacciones propias, asi que tampoco necesita bloque anti-FOUC.

// -----------------------------------------------------------------------------
// PRECIOS
// -----------------------------------------------------------------------------
// TODO dato de aqui sale de la guia de costes publicada por la propia empresa,
// /post/pergola-cost-south-florida ("Average Pergola Cost in South Florida
// (2026)"), y coincide con /post/aluminum-pergola-cost-boca-raton-vs-fort-lauderdale.
// No hay ni un numero inventado: si el cliente actualiza sus tarifas, se
// actualizan las dos tablas de abajo y ya.
//
// El "+" del articulo ($150+, $175+) significa que el techo es abierto; se
// arrastra hasta el resultado para no dar una cifra maxima que no es tal.

const ESTRUCTURAS = [
  { id: 'open-air',  nombre: 'Open-Air Aluminum Pergola',    min: 85,  max: 110, techoAbierto: false,
    nota: 'Shade and architecture without full weather control.', href: '/products/open-air-pergolas' },
  { id: 'insulated', nombre: 'Insulated Roof Pergola',       min: 95,  max: 130, techoAbierto: false,
    nota: 'Heat control and full rain cover. Popular on the coast.', href: '/products/solid-roof-pergolas' },
  { id: 'louvered',  nombre: 'Motorized Louvered Roof',      min: 110, max: 150, techoAbierto: true,
    nota: 'Open or close the roof on demand. Year-round usability.', href: '/products/motorized-louvered-pergolas' },
  { id: 'cabana',    nombre: 'Aluminum Cabana Structure',    min: 120, max: 175, techoAbierto: true,
    nota: 'Free-standing structures for pools and estate properties.', href: '/products/cabanas' },
];

const EXTRAS = [
  { id: 'engineering', nombre: 'Engineering & wind-load calculations', min: 2000, max: 5000,  techoAbierto: true,
    nota: 'Sealed drawings for Florida wind-load compliance.' },
  { id: 'footings',    nombre: 'Concrete footings',                    min: 3000, max: 10000, techoAbierto: true,
    nota: 'Depth depends on soil and span.' },
  { id: 'electrical',  nombre: 'Electrical & automation',              min: 1000, max: 4000,  techoAbierto: true,
    nota: 'Integrated lighting, fans, motorized screens.' },
  { id: 'waterfront',  nombre: 'Waterfront lot',                       min: 5000, max: 15000, techoAbierto: false,
    nota: 'Deeper footings and longer spans on Intracoastal and oceanfront lots.' },
];

// Medidas por defecto: 16 x 20 ft = 320 sq ft, un tamano corriente de patio.
const ANCHO_POR_DEFECTO = 16;
const LARGO_POR_DEFECTO = 20;

const datos = JSON.stringify({ estructuras: ESTRUCTURAS, extras: EXTRAS });

// Migas. Es una pagina de primer nivel, asi que el rastro es Home > Project Estimator.
const jsonLd = grafo(breadcrumbs(Astro.site!.href, [['Project Estimator', '/project-estimator']]));
---

<BaseLayout
  title="Pergola Cost Estimator | Pergola Plus Florida"
  description="Estimate your custom pergola or patio cover investment in South Florida using our published 2026 installed price ranges. No contact details required."
  jsonLd={jsonLd}
>
  <header class="header-page">
    <div class="w-layout-blockcontainer container w-container">
      <div class="wrapper-hero-page">
        <h1>Project Estimator</h1>
        <div>
          Price your pergola or patio cover in minutes using our published 2026
          installed rates for Miami-Dade, Broward, and Palm Beach County. No
          contact details required — you will see the range immediately.
        </div>
      </div>
    </div>
  </header>

  <section class="body-page">
    <div class="w-layout-blockcontainer container w-container">
      <div class="est">
        <form class="est-form" id="est-form" novalidate>
          <fieldset class="est-bloque">
            <legend class="est-legend">1 · Structure type</legend>
            <div class="est-opciones">
              {ESTRUCTURAS.map((e, i) => (
                <label class="est-opcion">
                  <input type="radio" name="estructura" value={e.id} checked={i === 0} />
                  <span class="est-opcion-cuerpo">
                    <span class="est-opcion-titulo">{e.nombre}</span>
                    <span class="est-opcion-nota">{e.nota}</span>
                    <span class="est-opcion-tarifa">
                      ${e.min}–${e.max}{e.techoAbierto ? '+' : ''} <span class="est-unidad">per sq ft installed</span>
                    </span>
                  </span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="est-bloque">
            <legend class="est-legend">2 · Size</legend>
            <div class="est-medidas">
              <label class="est-medida">
                <span>Width (ft)</span>
                <input type="number" id="est-ancho" name="ancho" value={ANCHO_POR_DEFECTO}
                       min="8" max="60" step="1" inputmode="numeric" />
              </label>
              <span class="est-por" aria-hidden="true">×</span>
              <label class="est-medida">
                <span>Length (ft)</span>
                <input type="number" id="est-largo" name="largo" value={LARGO_POR_DEFECTO}
                       min="8" max="60" step="1" inputmode="numeric" />
              </label>
              <p class="est-area">= <strong id="est-area">{ANCHO_POR_DEFECTO * LARGO_POR_DEFECTO}</strong> sq ft</p>
            </div>
            <p class="est-aviso" id="est-aviso" hidden></p>
          </fieldset>

          <fieldset class="est-bloque">
            <legend class="est-legend">3 · Add what your project needs</legend>
            <p class="est-ayuda">
              These are the items that most often move a South Florida project above the
              base rate. Leave them unchecked if you are not sure — we confirm them on site.
            </p>
            <div class="est-opciones est-opciones--extras">
              {EXTRAS.map((x) => (
                <label class="est-opcion">
                  <input type="checkbox" name="extra" value={x.id} />
                  <span class="est-opcion-cuerpo">
                    <span class="est-opcion-titulo">{x.nombre}</span>
                    <span class="est-opcion-nota">{x.nota}</span>
                    <span class="est-opcion-tarifa">
                      +${x.min.toLocaleString('en-US')}–${x.max.toLocaleString('en-US')}{x.techoAbierto ? '+' : ''}
                    </span>
                  </span>
                </label>
              ))}
            </div>
          </fieldset>
        </form>

        <aside class="est-panel">
          <div class="est-resultado" aria-live="polite">
            <p class="est-resultado-etiqueta">Estimated investment</p>
            <p class="est-resultado-cifra" id="est-total">—</p>
            <p class="est-resultado-sub" id="est-sub"></p>
            <ul class="est-desglose" id="est-desglose"></ul>
          </div>

          <p class="est-legal">
            <strong>This is an estimate, not a quote.</strong> The ranges come from our
            published <a href="/post/pergola-cost-south-florida">2026 South Florida cost
            guide</a>. Final pricing depends on your site, span, wind-load engineering,
            HOA and permitting requirements, and finish selections, and is confirmed only
            after an on-site assessment. Nothing here is a binding offer.
          </p>

          <div class="est-cta">
            <a href="/contact-us/get-a-quote" class="button w-button">Get an exact quote</a>
            <a href="/contact-us/schedule-a-visit" class="button secundary w-button">Schedule a visit</a>
          </div>
        </aside>
      </div>

      <noscript>
        <div class="est-noscript">
          <h2>2026 installed rates</h2>
          <table class="est-tabla">
            <thead><tr><th>Structure</th><th>Per sq ft installed</th></tr></thead>
            <tbody>
              {ESTRUCTURAS.map((e) => (
                <tr><td><a href={e.href}>{e.nombre}</a></td><td>${e.min}–${e.max}{e.techoAbierto ? '+' : ''}</td></tr>
              ))}
            </tbody>
          </table>
          <table class="est-tabla">
            <thead><tr><th>Common addition</th><th>Typical cost</th></tr></thead>
            <tbody>
              {EXTRAS.map((x) => (
                <tr><td>{x.nombre}</td><td>${x.min.toLocaleString('en-US')}–${x.max.toLocaleString('en-US')}{x.techoAbierto ? '+' : ''}</td></tr>
              ))}
            </tbody>
          </table>
          <p>Multiply your area in square feet by the rate above, then add what applies.
             <a href="/contact-us/get-a-quote">Request a quote</a> for exact pricing.</p>
        </div>
      </noscript>
    </div>
  </section>

  <section class="call-to-action-footer">
    <div class="wrapper-call-to-action">
      <div class="box-call-to-action">
        <h2>Request your free Estimate</h2>
        <div>Meet with our exterior designers for a free consultation. We'll assess your space and goals to plan the installation of pergolas, patio covers, or pool enclosures.</div>
        <div class="process-cta">
          <a href="/contact-us/get-a-quote" class="button w-button">Get A Quote</a>
          <a href="/contact-us/schedule-a-visit" class="button secundary w-button">Schedule A Visit</a>
        </div>
      </div>
    </div>
