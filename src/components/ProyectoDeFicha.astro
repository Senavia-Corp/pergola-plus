---
/**
 * «Un proyecto real» — la seccion 9 de la ficha de producto, CONDICIONAL.
 *
 * HOY NO RENDERIZA EN NINGUNA FICHA DE LAMAS, y eso es correcto: ninguno de los 13
 * proyectos esta etiquetado «Motorized Louvered Pergolas». La condicion de render es
 * que exista al menos un proyecto con la etiqueta de esa ficha; con cero, no se pinta
 * nada. Sin estado vacio, sin «proximamente» y sin caso inventado — misma regla que
 * `ReseñasGoogle.astro`, y por el mismo motivo.
 *
 * OCUPA EL TURNO OSCURO DEL VIDEO, Y ESO SON DOS COSAS, NO UNA. Esta seccion no se
 * suma a la pagina: SUSTITUYE al bloque de video. El video se retira con
 * `video: false` en el registro de fichas Y esta seccion se coloca DONDE ESTABA —
 * detras de las reseñas, no delante— con su mismo fondo `--primary`. Los dos hacen
 * el mismo trabajo (demostrar obra propia), el video es un `<iframe>` de
 * cdn.embedly.com —la unica dependencia externa que le quedaba a esta pagina— y un
 * proyecto propio con ciudad y sistema es mejor prueba que un video generico.
 *
 * SE HIZO SOLO LA PRIMERA MITAD Y SE PUBLICO ASI. Con la seccion delante de las
 * reseñas y sin fondo, las cuatro fichas con proyecto etiquetado encadenaban
 * #specs oscuro > esta clara > reseñas clara > #faq claro: hasta 4.879 px sin una
 * frontera, en solid-roof. Las 17 puertas estaban verdes. Medido muestreando el
 * pixel real de cada banda sobre dist, no leyendo el CSS: esta seccion y
 * `.resenas` parecen neutras en el codigo y en pantalla son claras.
 *
 * LO QUE NO PUEDE PASAR: que una ficha traiga video Y proyecto etiquetado. Serian
 * dos bandas oscuras seguidas. Lo vigila `scripts/comprobar-ritmo.mjs`.
 *
 * EL ESPAÑOL SALE DE `PROYECTOS_ES`, no del diccionario del fragmento: el titulo y el
 * texto de la tarjeta son los del proyecto, y esa traduccion ya existe. Si algun dia
 * se etiqueta un proyecto que no esta traducido, la tarjeta se queda fuera de /es/ en
 * vez de salir en ingles, igual que hace el listado del blog.
 */
import { proyectosDeFicha } from '../lib/proyectos-ficha';
import { PROYECTOS_ES } from '../i18n/proyectos.es';

interface Props {
  /** El slug de la ficha de producto. */
  slug: string;
  idioma?: 'en' | 'es';
  /** Titular y entradilla de la seccion, en el idioma de la pagina. */
  titulo: string;
  entradilla: string;
}

const { slug, idioma = 'en', titulo, entradilla } = Astro.props;

// El HTML de la galeria se importa en crudo, igual que los fragmentos de las fichas.
// Es salida generada y por tanto la unica fuente donde vive la etiqueta de producto.
const galeria = Object.values(import.meta.glob(
  '../contenido-migrado/estaticas/project-gallery.html',
  { query: '?raw', import: 'default', eager: true },
))[0] as string;

const tarjetas = proyectosDeFicha(galeria, slug)
  .map((t) => {
    if (idioma !== 'es') return { ...t, ruta: `/project/${t.slug}` };
    const es = PROYECTOS_ES[t.slug];
    if (!es) return null;
    return { ...t, ruta: `/es/project/${t.slug}/`, titulo: es.nombre, texto: es.description };
  })
  .filter((t) => t !== null)
  // DOS Y NO LAS QUE HAYA: el titular dice «One We Built» / «Un proyecto real», en
  // singular, y `solid-roof-pergolas` tiene NUEVE proyectos etiquetados — 3.024 px
  // de seccion bajo un titular que promete uno. Dos es una fila entera de la rejilla
  // de dos columnas, asi que no deja huecos, y las demas siguen en /project-gallery/.
  .slice(0, 2);
---

{tarjetas.length > 0 && (
  <section class="pp-proyecto-ficha">
    <div class="w-layout-blockcontainer container w-container">
      <div class="header-feature-section" data-pp-reveal>
        <h2>{titulo}</h2>
        <div>{entradilla}</div>
      </div>
      <div role="list" class="projects-grid-list w-dyn-items">
        {tarjetas.map((t) => (
          <div role="listitem" class="projects-grid-item w-dyn-item">
            <a href={t.ruta} class="projects-card-page w-inline-block">
              <img src={t.imagen} loading="lazy" alt={t.alt} class="projects-card-image" />
              <div class="projects-card-body-page">
                <div class="box-card-body-projects">
                  {t.etiquetas.map((e) => (
                    <div class="box-detail-projects"><div>{e}</div></div>
                  ))}
                </div>
                <h3 class="projects-card-h3">{t.titulo}</h3>
                <div class="projects-card-text">{t.texto}</div>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  /* La rejilla y la tarjeta son clases del sitio (`projects-grid-list`,
     `projects-card-page`), asi que aqui solo va el hueco de la seccion. */
  /* El turno OSCURO que deja el video, con su mismo fondo y su mismo hueco
     (`.video-section` es `background-color: var(--primary); padding: 8rem 2rem`).
     La pareja fondo+color es la que ya usa `.pp-specs`, la otra seccion nuestra
     que va en oscuro. */
  .pp-proyecto-ficha {
    background-color: var(--primary, #3a545b);
    color: var(--white, #fff);
    padding: 8rem 2rem;
  }

  /* LA TARJETA HAY QUE RESCATARLA. `.projects-card-body-page` es `--primary` en el
     CSS del sitio —medido en pantalla: rgb(58,84,91)— porque en /project-gallery/
     va sobre fondo claro. Sobre esta seccion, ahora del mismo color, el cuerpo de
     la tarjeta se disolveria en el fondo y solo quedaria la foto flotando. Se
     invierte a crema DENTRO DE ESTA SECCION Y SOLO AQUI, con el mismo recurso de
     «panel crema sobre primary» que usa `.pp-specs`. */
  .pp-proyecto-ficha .projects-card-body-page {
    background-color: var(--secundary, #fffbf0);
    color: var(--primary, #3a545b);
  }

  /* Y las etiquetas, que eran crema sobre crema en cuanto se invierte el cuerpo. */
  .pp-proyecto-ficha .box-detail-projects {
    background-color: var(--primary, #3a545b);
    color: var(--white, #fff);
  }

  .pp-proyecto-ficha .projects-grid-list {
    margin-top: 3rem;
  }

  @media screen and (max-width: 767px) {
    .pp-proyecto-ficha {
      padding: 4rem 1rem;
    }
  }
</style>
