---
// Footer — CODIGO DE AUTORIA PROPIA. Se edita a mano.
//
// Nacio como extraccion de index.html via scripts/generar-shell.mjs, pero desde
// el rediseno del menu ya no se genera (ese script esta retirado).
//
// El formulario de suscripcion queda con action="" a proposito: se cablea en la
// Fase 3 junto con Turnstile.
//
// Los data-w-id de aqui SI son IX2 (SCROLL_INTO_VIEW). No borrarlos.
import { idiomaDeRuta } from '../i18n';
import { traductor } from '../i18n/shell';

const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const esActiva = (href: string) => ruta === href || ruta.startsWith(href + '/');
const t = traductor(idiomaDeRuta(Astro.url.pathname));
---
  <footer class="footer">
    <div class="w-layout-blockcontainer container-menu w-container">
      <div class="wrapper-footer">
        <div data-w-id="e5de5a0c-53a0-ec9b-3b42-737243767a7e" class="column-left-footer"><img loading="lazy" src="/images/Logo-White.svg" alt="Pergola Plus Florida Logo" class="logo-footer">
          <div>{t('footerSuscribete')}</div>
          <div class="form-block w-form">
            {/* El formulario del pie va en las 107 paginas, asi que es el que mas
                trafico ve. Llego de Webflow con method="get" y sin action: se
                enviaba y no lo recibia nadie.

                `pagina` se rellena en SERVIDOR para que llegue tambien sin
                JavaScript; `t` y `js` los pone Formulario.astro y van vacios si no
                hay JS, con lo que la comprobacion de los 2 segundos no se aplica.

                El id del campo es "footer-email" y no "email": el formulario de
                presupuesto ya usa id="email", y dos elementos con el mismo id en la
                misma pagina rompen el <label for> y la navegacion por teclado. */}
            {/* data-wf-no-turnstile: el modulo `forms` de webflow.js, en cuanto ve
                un `data-turnstile-sitekey` en la pagina, carga Turnstile y deja
                todos los formularios en estado "enviando" con el submit
                deshabilitado, esperando un widget que este sitio no renderiza.
                Arrastraba tambien a este, que va en las 107 paginas. Medido en
                /contact-us/get-a-quote: este boton salia con `disabled` y clase
                `w-form-loading` sin haber enviado nada. */}
            <form
              id="wf-form-Footer-Form"
              name="wf-form-Footer-Form"
              data-name="Footer Form"
              data-wf-no-turnstile
              method="post"
              action="/api/lead"
              class="form">
              <input type="hidden" name="formulario" value="footer" />
              <input type="hidden" name="pagina" value={Astro.url.pathname} />
              <input type="hidden" name="t" value="" />
              <input type="hidden" name="js" value="" />
              {/* La trampa no lleva <label>: el contenedor es aria-hidden, asi que
                  ningun lector de pantalla llega al campo y la etiqueta solo anadiria
                  texto a las 107 paginas. */}
              <div class="pp-trampa" aria-hidden="true">
                <input type="text" id="pp-website-footer" name="website" tabindex="-1" autocomplete="off" />
              </div>
              {/* <label> de verdad, oculto a la vista. No lleva ademas aria-label: con
                  los dos puestos gana el aria-label y el <label> se ignora, asi que
                  seria texto duplicado en las 107 paginas para nada. */}
              <label class="pp-trampa" for="footer-email">{t('footerEmail')}</label>
              <input
                class="text-field w-input"
                maxlength="256"
                name="email"
                data-name="Email"
                placeholder={t('footerEmail')}
                type="email"
                id="footer-email"
                autocomplete="email"
                required
              />
              <input type="submit" data-wait={t('footerEspera')} class="submit-button w-button" value={t('footerBoton')} />
            </form>
            {/* Los dos estados de Webflow se quedan: el CSS migrado los oculta hasta
                que se les pone la clase, y ya no los usa nadie —el exito es un 303 a
                /thank-you y los errores los pinta .pp-resumen— pero quitarlos
                cambiaria el flujo del layout en las 107 paginas. */}
            <div class="w-form-done">
              <div>{t('footerFormOk')}</div>
            </div>
            <div class="w-form-fail">
              <div>{t('footerFormError')}</div>
            </div>
          </div>
          <div class="text-block">{t('footerLegal')}</div>
        </div>
        <div class="column-right-footer">
          <div class="item-footer">
            <div class="heading-footer">{t('footerHelp')}</div>
            <ul role="list" class="list-footer">
              <li>
                <a href="/products" class="link-footer">{t('footerProductos')}</a>
              </li>
              <li>
                <a href="/services" class="link-footer">{t('footerServicios')}</a>
              </li>
              <li>
                <a href="/project-gallery" class="link-footer">{t('footerGaleria')}</a>
              </li>
              <li>
                <a href="/project-estimator" class:list={["link-footer", { "w--current": esActiva("/project-estimator") }]} aria-current={esActiva("/project-estimator") ? "page" : undefined}>{t('footerEstimador')}</a>
              </li>
              <li>
                <a href="/contact-us/get-in-touch" class="link-footer">{t('footerContacto')}</a>
              </li>
              <li>
                <a href="/resources/blog" class="link-footer">{t('footerBlog')}</a>
              </li>
              <li>
                <a href="/resources/faq" class="link-footer">{t('footerFaq')}</a>
              </li>
            </ul>
          </div>
          <div class="item-footer">
            <div class="heading-footer">{t('footerCompany')}</div>
            <ul role="list" class="list-footer">
              <li>
                <a href="/about-us" class="link-footer">{t('footerAbout')}</a>
              </li>
              <li>
                <a href="/about-us/brands" class="link-footer">{t('footerBrands')}</a>
              </li>
              <li>
                <a href="/about-us/where-we-work" class="link-footer">{t('footerWhere')}</a>
              </li>
              <li>
                <a href="/about-us/industries-we-serve" class="link-footer">{t('footerIndustries')}</a>
              </li>
              <li>
                {/* Venia con href="#" del export. La pagina existe. */}
                <a href="/about-us/testimonials" class="link-footer">{t('footerTestimonials')}</a>
              </li>
            </ul>
          </div>
          <div class="item-footer">
            <div class="heading-footer">{t('footerFollow')}</div>
            <ul role="list" class="list-footer-social">
              <li>
                <a href="https://www.facebook.com/p/Pergola-Plus-Corp-100089973993816/" target="_blank" class="link-block w-inline-block"><img loading="lazy" src="/images/Facebook.svg" alt="" class="icon-social-media">
                  <div class="link-footer">Facebook</div>
                </a>
              </li>
              <li>
                <a href="https://www.instagram.com/pergolaplusflorida/" target="_blank" class="link-block w-inline-block"><img loading="lazy" src="/images/Instagram.svg" alt="" class="icon-social-media">
                  <div class="link-footer">Instagram</div>
                </a>
              </li>
              <li>
                <a href="https://www.youtube.com/@pergolapluscorp" target="_blank" class="link-block w-inline-block"><img loading="lazy" src="/images/Youtube.svg" alt="" class="icon-social-media">
                  <div class="link-footer">YouTube</div>
                </a>
              </li>
              <li>
                <a href="https://www.tiktok.com/@pergolaplus" target="_blank" class="link-block w-inline-block"><img loading="lazy" src="/images/Tiktok.svg" alt="" class="icon-social-media">
                  <div class="link-footer">TikTok</div>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
      <div data-w-id="9e3abbef-7c3b-f086-0635-e97421a15e4b" class="div-block-7">
        <div>
          <div class="div-block-6">
            <a href="https://www.bbb.org/us/fl/boca-raton/profile/pool-enclosures/pergola-plus-corp-0633-92032287" target="_blank" class="w-inline-block"><img loading="lazy" src="/images/bbb.svg" alt="" class="bbb"></a>
            <div>{t('footerLicencia')}</div>
          </div>
        </div>
        {/* Aqui vivia el traductor de Elfsight (plan gratuito, host perezoso a
            14344px de scroll: no llegaba a aplicarse al navegar). Retirado. El
            espanol se hara con i18n real de Astro en una fase aparte. */}
      </div>
      <div data-w-id="e5de5a0c-53a0-ec9b-3b42-737243767ad0" class="line-footer"></div>
      <div data-w-id="e5de5a0c-53a0-ec9b-3b42-737243767ad1" class="wrapper-bar-footer">
        <div class="link-footer">{t('footerDerechos')}</div>
        <div class="link-footer">{t('footerDesarrollado')} <a href="https://www.senaviacorp.com/" target="_blank" class="link"><strong>Senavia Corp.</strong></a>
        </div>
        {/* Esto era una coleccion del CMS de Webflow que llegaba VACIA: un solo
            <a href="#" class="link-footer"></a> sin texto, asi que las dos
            paginas legales no tenian enlace desde ningun sitio. Ambas existen
            (/articles/privacy-policy y /articles/terms-of-service), asi que se
            escriben tal cual: son dos, no necesitan coleccion. */}
        <div>
          <div class="collection-list-articles">
            <a href="/articles/privacy-policy" class="link-footer">{t('footerPrivacidad')}</a>
            <a href="/articles/terms-of-service" class="link-footer">{t('footerTerminos')}</a>
          </div>
        </div>
      </div>
    </div>
  </footer>
