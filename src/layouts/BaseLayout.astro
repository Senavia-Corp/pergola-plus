---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// BaseLayout — el <head> y el chrome, en el MISMO orden que el HTML original.
//
// Reglas que NO se pueden romper (ver docs/fase0-hallazgos.md y el plan):
//  - Los 3 CSS van en este orden exacto: normalize -> webflow -> sitio.
//  - jQuery va ANTES que webflow.js, ambos al final del <body>.
//  - webflow.js lleva dentro las 749 interacciones IX2 del sitio.
//  - `pageStyles` es el bloque anti-FOUC que Webflow inyecta por pagina
//    (html.w-mod-js:not(.w-mod-ix) [data-w-id="..."]{opacity:0}). Solo 7 de las
//    34 paginas lo llevan y cada una tiene los suyos: se copia LITERAL, no se
//    comparte entre paginas. Sin el, los elementos animados aparecen y luego
//    saltan.
//  - NO anadir <ClientRouter />: IX2 se inicializa una sola vez por documento,
//    asi que con View Transitions las animaciones mueren de la 2a pagina en
//    adelante.

interface Props {
  title: string;
  description?: string;
  /** Ruta absoluta de la imagen og. Por defecto la del sitio. */
  ogImage?: string;
  /** URL canonica. Por defecto, la ruta actual sobre `site`. */
  canonical?: string;
  /** Bloque <style> anti-FOUC especifico de la pagina. Copiar literal del original. */
  pageStyles?: string;
  /**
   * data-wf-page de la pagina original. NO es un metadato decorativo: IX2 lo lee
   * (es una constante suya dentro de webflow.js) para saber que interacciones
   * cargar. Sin el, los elementos con opacity:0 nunca se revelan.
   */
  wfPage?: string;
  wfSite?: string;
}

const {
  title,
  description = 'Licensed South Florida pergola contractor. Custom motorized louvered pergolas, patio covers & outdoor structures. 10+ years experience. Free quote.',
  ogImage,
  canonical,
  pageStyles,
  wfPage,
  wfSite,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
---

<!DOCTYPE html>
<html lang="en" data-wf-page={wfPage} data-wf-site={wfSite}>
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta content={description} name="description" />
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta property="og:type" content="website" />
    <meta content="summary_large_image" name="twitter:card" />
    {ogImage && <meta content={ogImage} property="og:image" />}
    {ogImage && <meta content={ogImage} name="twitter:image" />}
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <link rel="canonical" href={canonicalUrl} />

    <link href="/css/normalize.css" rel="stylesheet" type="text/css" />
    <link href="/css/webflow.css" rel="stylesheet" type="text/css" />
    <link href="/css/pergola-plus-florida.webflow.css" rel="stylesheet" type="text/css" />

    {pageStyles && <style set:html={pageStyles} />}

    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="anonymous" />
    <script src="https://ajax.googleapis.com/ajax/libs/webfont/1.6.26/webfont.js" type="text/javascript" is:inline></script>
    <script type="text/javascript" is:inline>WebFont.load({  google: {    families: ["Inter:300,400,500,600,700"]  }});</script>

    {/* Pone w-mod-js / w-mod-touch en <html>. El selector anti-FOUC depende de
        w-mod-js, asi que este script tiene que ir en el <head> y sin defer. */}
    <script type="text/javascript" is:inline>!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>

    <link href="/images/favicon.png" rel="shortcut icon" type="image/x-icon" />
    <link href="/images/webclip.png" rel="apple-touch-icon" />

    {/* Elfsight. El sitio usa 4 apps: WhatsApp Chat y Click to Call viven aqui
        (botones flotantes en las 34 paginas), y Website Translator (25 paginas)
        y Google Reviews (8) van dentro del cuerpo de cada pagina.
        El original cargaba platform.js una vez por app; con una basta.
        TODO Fase 4: decidir con el cliente. WhatsApp y Click-to-Call se
        sustituyen por botones propios sin problema, pero el Translator es
        multi-idioma de verdad y Google Reviews es contenido: reemplazarlos
        es trabajo, no un borrado. */}
    <script src="https://elfsightcdn.com/platform.js" async is:inline></script>
    <div class="elfsight-app-9475d8c6-23cc-48ec-a267-bb10f8175418" data-elfsight-app-lazy></div>
    <div class="elfsight-app-0426344c-df60-46cb-beee-2c9390923a32" data-elfsight-app-lazy></div>
  </head>

  <body>
    {/* Contenedor de codigo embebido de Webflow. Va vacio, pero ocupa sitio en
        el layout: quitarlo cambiaria el flujo del documento. */}
    <div class="body-code">
      <div class="code-embed-3 w-embed"></div>
    </div>

    <Nav />
    <slot />
    <Footer />

    {/* jQuery ANTES que webflow.js. El integrity y el crossorigin son los del
        original: no tocarlos. */}
    <script
      src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js"
      type="text/javascript"
      integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0="
      crossorigin="anonymous"
      is:inline></script>
    <script src="/js/webflow.js" type="text/javascript" is:inline></script>
  </body>
</html>
