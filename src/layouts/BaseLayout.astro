---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Carrusel from '../components/Carrusel.astro';
import Formulario from '../components/Formulario.astro';
import Agenda from '../components/Agenda.astro';
import { idiomaDeRuta, rutaEnIdioma } from '../i18n';
// Va PRIMERO: define los @font-face, y el CSS migrado que viene después ya usa Inter.
import '../styles/fuentes.css';
import '../styles/i18n.css';
import '../styles/accesibilidad.css';

// BaseLayout — el <head> y el chrome, en el MISMO orden que el HTML original.
//
// Reglas que NO se pueden romper (ver docs/fase0-hallazgos.md y el plan):
//  - Los 3 CSS van en este orden exacto: normalize -> webflow -> sitio.
//  - jQuery va ANTES que webflow.js, ambos al final del <body>.
//  - webflow.js lleva dentro las 749 interacciones IX2 del sitio.
//  - `pageStyles` es el bloque anti-FOUC que Webflow inyecta por pagina
//    (html.w-mod-js:not(.w-mod-ix) [data-w-id="..."]{opacity:0}). Solo 7 de las
//    34 paginas lo llevan y cada una tiene los suyos: se copia LITERAL, no se
//    comparte entre paginas. Sin el, los elementos animados aparecen y luego
//    saltan.
//  - NO anadir <ClientRouter />: IX2 se inicializa una sola vez por documento,
//    asi que con View Transitions las animaciones mueren de la 2a pagina en
//    adelante.

interface Props {
  title: string;
  description?: string;
  /** Ruta absoluta de la imagen og. Por defecto la del sitio. */
  ogImage?: string;
  /** URL canonica. Por defecto, la ruta actual sobre `site`. */
  canonical?: string;
  /** Bloque <style> anti-FOUC especifico de la pagina. Copiar literal del original. */
  pageStyles?: string;
  /**
   * data-wf-page de la pagina original. NO es un metadato decorativo: IX2 lo lee
   * (es una constante suya dentro de webflow.js) para saber que interacciones
   * cargar. Sin el, los elementos con opacity:0 nunca se revelan.
   */
  wfPage?: string;
  wfSite?: string;
  /**
   * og:type. El sitio migrado manda "website" en las 100 paginas, que es incorrecto
   * en los 21 posts del blog: ahi va "article".
   */
  ogType?: string;
  /**
   * JSON-LD de la pagina. Se serializa tal cual dentro de un
   * <script type="application/ld+json">.
   *
   * Es una prop y no un slot de <head> porque este layout no tiene slots con
   * nombre, y anadir uno obligaria a tocar las 25 paginas que ya lo usan.
   */
  jsonLd?: unknown;
}

const {
  title,
  description = 'Licensed South Florida pergola contractor. Custom motorized louvered pergolas, patio covers & outdoor structures. 10+ years experience. Free quote.',
  ogImage,
  canonical,
  pageStyles,
  wfPage,
  wfSite,
  ogType = 'website',
  jsonLd,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;

// El idioma sale de la ruta: todo lo que cuelgue de /es/ es español. Sin esto el
// <html lang="en"> mentiria en la version española, y lang es lo que usan los
// lectores de pantalla para elegir voz y los buscadores para segmentar.
const idiomaPagina = idiomaDeRuta(Astro.url.pathname);

// Solo se declara el `hreflang` de las traducciones que EXISTEN. `rutaEnIdioma`
// devuelve null cuando no hay gemela y aquí se filtra.
//
// Antes esto emitía siempre las dos, y como la función mandaba cualquier ruta a
// `/es/`, 106 páginas declaraban una traducción inexistente y todas apuntaban a la
// misma. El `x-default` también se emitía a ciegas.
//
// Un par de hreflang tiene que ser RECÍPROCO para que Google se lo crea: si /a
// declara /es/a, /es/a tiene que declarar /a. Al salir las dos del mismo mapa
// (TRADUCIDAS, en src/i18n/index.ts), la reciprocidad es automática.
const encontradas = (['en', 'es'] as const)
  .map((hreflang) => ({ hreflang, ruta: rutaEnIdioma(Astro.url.pathname, hreflang) }))
  .filter((a): a is { hreflang: 'en' | 'es'; ruta: string } => a.ruta !== null);

// Con UNA sola versión no se emite nada. Un `hreflang` solitario que apunta a la
// propia página no le dice nada a Google —no hay alternativa que elegir— y encima
// insinúa que existe un grupo de traducciones incompleto. O el par entero, o nada.
const alternativas = encontradas.length > 1
  ? encontradas.map((a) => ({ hreflang: a.hreflang, href: new URL(a.ruta, Astro.site).href }))
  : [];

// x-default apunta a la versión que se sirve a quien no encaja en ningún idioma
// declarado: aquí, la inglesa.
const xDefault = alternativas.length > 1
  ? alternativas.find((a) => a.hreflang === 'en')?.href ?? null
  : null;
---

<!DOCTYPE html>
<html lang={idiomaPagina === 'es' ? 'es' : 'en'} data-wf-page={wfPage} data-wf-site={wfSite}>
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta content={description} name="description" />
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta property="og:type" content={ogType} />
    <meta content="summary_large_image" name="twitter:card" />
    {ogImage && <meta content={ogImage} property="og:image" />}
    {ogImage && <meta content={ogImage} name="twitter:image" />}
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <link rel="canonical" href={canonicalUrl} />
    {alternativas.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Pergola Plus Florida — Blog"
      href="/resources/blog/rss.xml"
    />
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}

    <link href="/css/normalize.css" rel="stylesheet" type="text/css" />
    <link href="/css/webflow.css" rel="stylesheet" type="text/css" />
    <link href="/css/pergola-plus-florida.webflow.css" rel="stylesheet" type="text/css" />

    {pageStyles && <style set:html={pageStyles} />}

    {/* Inter AUTOALOJADA. Aquí vivían cuatro líneas que costaban caro en las 113
        páginas: dos `preconnect` a Google y `webfont.js` de ajax.googleapis.com en
        el <head> y SIN defer — es decir, una petición a un tercero que bloquea el
        render, ~20 KB de JavaScript ejecutándose antes de pintar nada, y solo
        entonces la petición real de la fuente a un TERCER dominio.

        Ahora es una petición, a nuestro dominio, sin JavaScript y con
        `font-display: swap`, así que el texto se lee desde el primer frame.

        Los .woff2 se versionan y los baja scripts/bajar-fuentes.mjs a mano: el
        despliegue no debería depender de que Google conteste. */}
    <link
      rel="preload"
      href="/fonts/inter-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    {/* Pone w-mod-js / w-mod-touch en <html>. El selector anti-FOUC depende de
        w-mod-js, asi que este script tiene que ir en el <head> y sin defer. */}
    <script type="text/javascript" is:inline>!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>

    <link href="/images/favicon.png" rel="shortcut icon" type="image/x-icon" />
    <link href="/images/webclip.png" rel="apple-touch-icon" />

    {/* Elfsight retirado por completo (las 4 apps). Se midio antes de decidir:
         - Translator: plan GRATUITO (display_free_link:true, hide_elfsight_logo:0,
           upgrade con claim=removeBranding&claim=increaseViews). Su unico host
           llevaba data-elfsight-app-lazy y vivia a 14344px de scroll en el pie,
           asi que no arrancaba salvo que el visitante bajara del todo: medido en
           /project-gallery, 43s con "es-ES" ya guardado y la pagina seguia en
           ingles. El espanol se hara con i18n real de Astro en una fase aparte.
         - Google Reviews: la API devuelve WIDGET_DISABLED. Llevaba tiempo muerto
           en las 40 paginas que lo incrustaban; retirarlo no cuesta contenido.
         - WhatsApp y Click-to-Call: sustituidos por los dos enlaces de abajo.
       Con esto se va tambien platform.js y sus 3 scripts de widget. */}
  </head>

  <body>
    {/* Contenedor de codigo embebido de Webflow. Va vacio, pero ocupa sitio en
        el layout: quitarlo cambiaria el flujo del documento. */}
    <div class="body-code">
      <div class="code-embed-3 w-embed"></div>
    </div>

    <Nav />
    <slot />
    <Footer />

    {/* Cablea las flechas de los carruseles, que la migracion dejo muertas al no
        traerse el script de Finsweet. Va aqui y no en el <head> porque necesita el
        DOM y porque el CSS que lo acompana es el que devuelve el scroll. */}
    <Carrusel />

    {/* Mejora los 3 formularios: evita la recarga, pinta los errores junto al campo
        y convierte el multipaso en multipaso. Si no carga, no se pierde ni un lead:
        sin JavaScript el POST es nativo y el endpoint responde 303. */}
    <Formulario />

    {/* Difiere el calendario de OnceHub hasta que se acerca a pantalla. No hace nada
        en las 105 páginas que no lo llevan. */}
    <Agenda />

    {/* Sustitutos propios de los 2 botones flotantes de Elfsight. Dos enlaces:
        sin JS, sin platform.js, sin cuota de terceros. Numeros tomados de la
        configuracion de los widgets que habia: WhatsApp +15617108363 y
        Click-to-Call +1 (561) 710-8363 — el mismo. */}
    <div class="botones-flotantes">
      <a
        class="boton-flotante boton-flotante--tel"
        href="tel:+15617108363"
        aria-label="Call Pergola Plus Florida at (561) 710-8363">
        <svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M20.33,21.48l2.24-2.24a2.19,2.19,0,0,1,2.34-.48l2.73,1.09a2.18,2.18,0,0,1,1.36,2v5A2.17,2.17,0,0,1,26.72,29C7.59,27.81,3.73,11.61,3,5.41A2.17,2.17,0,0,1,5.17,3H10a2.16,2.16,0,0,1,2,1.36l1.09,2.73a2.16,2.16,0,0,1-.47,2.34l-2.24,2.24S11.67,20.4,20.33,21.48Z"></path>
        </svg>
      </a>
      <a
        class="boton-flotante boton-flotante--wa"
        href="https://wa.me/15617108363"
        target="_blank"
        rel="noopener"
        aria-label="Chat with Pergola Plus Florida on WhatsApp (opens in a new tab)">
        <svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M16.05 3a12.9 12.9 0 0 0-11 19.63L3 29l6.53-2A12.9 12.9 0 1 0 16.05 3Zm0 23.62a10.7 10.7 0 0 1-5.46-1.5l-.39-.23-4.05 1.24 1.25-3.95-.25-.4a10.72 10.72 0 1 1 8.9 4.84Zm5.88-8a13.9 13.9 0 0 1-1.62-.6c-.28-.1-.48-.15-.68.15s-.78.95-.95 1.15-.35.22-.65.07a8.72 8.72 0 0 1-2.57-1.59 9.7 9.7 0 0 1-1.78-2.22c-.19-.32 0-.49.14-.64s.3-.35.45-.53a2 2 0 0 0 .3-.5.55.55 0 0 0 0-.53c0-.15-.67-1.62-.92-2.22s-.49-.5-.68-.51h-.57a1.11 1.11 0 0 0-.8.37 3.34 3.34 0 0 0-1 2.48 5.79 5.79 0 0 0 1.21 3.07 13.25 13.25 0 0 0 5.07 4.48 16.5 16.5 0 0 0 1.69.63 4.07 4.07 0 0 0 1.87.12 3.06 3.06 0 0 0 2-1.41 2.48 2.48 0 0 0 .17-1.41c-.07-.13-.27-.2-.57-.35Z"></path>
        </svg>
      </a>
    </div>

    {/* jQuery ANTES que webflow.js. El integrity y el crossorigin son los del
        original: no tocarlos. */}
    <script
      src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js"
      type="text/javascript"
      integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0="
      crossorigin="anonymous"
      is:inline></script>
    <script src="/js/webflow.js" type="text/javascript" is:inline></script>
  </body>
</html>

<style>
  /* Botones flotantes propios (sustituyen a Elfsight WhatsApp + Click-to-Call).
     Bottom-left telefono y bottom-right WhatsApp: las mismas posiciones que
     ocupaban los widgets, para no mover el habito del visitante. */
  .botones-flotantes {
    position: fixed;
    inset: auto 0 0 0;
    /* Por DEBAJO del nav, que crea su contexto de apilado con z-index:20. Con un
       valor mayor el boton de WhatsApp se colaba encima del panel movil abierto
       (que es justo lo que hacian los widgets de Elfsight). */
    z-index: 15;
    display: flex;
    justify-content: space-between;
    padding: 1.25rem;
    pointer-events: none; /* solo los botones reciben el click, no la franja */
  }

  .boton-flotante {
    pointer-events: auto;
    width: 56px; /* muy por encima de los 44px de area tactil minima */
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: #fff;
    box-shadow: 0 2px 10px #0000004d;
    transition: transform .2s, box-shadow .2s;
  }

  .boton-flotante svg {
    width: 26px;
    height: 26px;
  }

  .boton-flotante--tel {
    background-color: var(--primary, #3a545b);
  }
  .boton-flotante--wa {
    background-color: #25d366;
  }

  .boton-flotante:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 14px #00000059;
  }

  /* El nav no tiene ni un solo indicador de foco; estos si. */
  .boton-flotante:focus-visible {
    outline: 3px solid var(--secundary, #fffbf0);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .boton-flotante {
      transition: none;
    }
    .boton-flotante:hover {
      transform: none;
    }
  }
</style>
