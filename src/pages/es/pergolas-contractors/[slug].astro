---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import items from '../../../contenido-migrado/pergolas-contractors/_items.json';
import { traducirHtml } from '../../../i18n';
import { UBICACIONES_ES } from '../../../i18n/ubicaciones.es';
import { COMUN_ES } from '../../../i18n/comun.es';
import { grafo, breadcrumbs, areaDeServicio } from '../../../lib/jsonld';
import { partirEnMarca, MARCA_RESENAS } from '../../../lib/faq-ficha';
import ReseñasGoogle from '../../../components/ReseñasGoogle.astro';

// Las páginas de ubicación en español. Misma estructura que /es/services/[slug]: el
// fragmento y los metadatos salen de los MISMOS ficheros que la versión inglesa.
//
// Solo se generan las que tienen diccionario en UBICACIONES_ES.

const fragmentos = import.meta.glob('../../../contenido-migrado/pergolas-contractors/*.html', {
  query: '?raw', import: 'default', eager: true,
});

export function getStaticPaths() {
  return items
    .filter((item) => UBICACIONES_ES[item.slug])
    .map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const traduccion = UBICACIONES_ES[item.slug]!;
const original = fragmentos['../../../contenido-migrado/pergolas-contractors/' + item.slug + '.html'];
if (!original) throw new Error(`[i18n] sin fragmento para pergolas-contractors/${item.slug}`);

const { html, traducidas, faltan } = traducirHtml(original as string, {
  ...COMUN_ES,
  ...traduccion.dic,
});

if (faltan.length) {
  console.warn(`\n  [i18n] /es/pergolas-contractors/${item.slug} — ${traducidas} traducidas, ${faltan.length} SIN traducir:`);
  for (const f of faltan) console.warn(`         · ${f.slice(0, 110)}`);
}

// El `area` es el nombre de la ciudad, que NO se traduce: es el topónimo con el que
// la busca Google y con el que la escribe el vecino.
// Se parte sobre el HTML YA TRADUCIDO y no sobre el original: es el que se sirve, y
// `traducirHtml` conserva los comentarios. Mismo orden que en es/services/[slug].
// `partirEnMarca` LANZA si la marca no esta.
const resenas = partirEnMarca(html, 'es/pergolas-contractors/' + item.slug, MARCA_RESENAS);

const site = Astro.site!.href;
const ruta = `/es/pergolas-contractors/${item.slug}/`;
const jsonLd = grafo(
  areaDeServicio(site, {
    nombre: `Pérgolas en ${traduccion.nombre}`,
    descripcion: traduccion.description,
    ruta,
    area: traduccion.nombre,
  }),
  breadcrumbs(site, [['Dónde trabajamos', '/es/about-us/where-we-work/'], [traduccion.nombre, ruta]], 'es'),
);
---

<BaseLayout
  title={traduccion.title}
  description={traduccion.description}
  ogImage={item.ogImage ?? undefined}
  wfPage={item.wfPage ?? undefined}
  wfSite={item.wfSite ?? undefined}
  jsonLd={jsonLd}
>
  <Fragment set:html={resenas.antes} />
  {/* DENTRO de la banda `reviews`, entre su titular y el boton a testimonios.
      `embebido` porque la banda YA trae titular y fondo propios; como banda
      propia salian dos secciones de Reviews, la blanca de Webflow vacia y una
      crema debajo con las tarjetas.

      El texto de cada resena sale en el idioma en que se escribio —no se
      traduce lo que dijo un cliente—; solo se traducen los rotulos. */}
  <ReseñasGoogle embebido />
  <Fragment set:html={resenas.despues} />
</BaseLayout>
