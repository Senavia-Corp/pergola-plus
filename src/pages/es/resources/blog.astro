---
/**
 * Listado del blog en español. Gemela de /resources/blog.
 *
 * El cuerpo es EL MISMO componente que el ingles (BlogListado.astro): las 21
 * tarjetas, el destacado, los filtros y el CTA no pueden divergir.
 */
import { canonica } from '../../../lib/canonica.mjs';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { PROPIAS_ES } from '../../../i18n/paginas-propias';
import BlogListado from '../../../components/BlogListado.astro';
import { posts, jsonLdBlog, WF_PAGE, WF_SITE } from '../../../lib/blog';
import { traducirPost } from '../../../i18n/blog.es';

const c = PROPIAS_ES.blog;
const TITULO = c.title;
const DESCRIPCION = c.description;

const site = Astro.site!;
const url = new URL(canonica('/es/resources/blog'), site).href;
---

<BaseLayout
  title={TITULO}
  description={DESCRIPCION}
  wfPage={WF_PAGE}
  wfSite={WF_SITE}
  jsonLd={jsonLdBlog({
    idioma: 'es-US',
    url,
    nombre: c.nombre,
    descripcion: DESCRIPCION,
    entradas: posts.map((p) => traducirPost(p, 'es')),
    site: site.href,
  })}
>
  <BlogListado
    activa="todo"
    titulo={c.titulo}
    intro={c.intro}
    idioma="es"
  />
</BaseLayout>
