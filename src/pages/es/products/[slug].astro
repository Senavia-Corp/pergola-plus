---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import items from '../../../contenido-migrado/products/_items.json';
import { traducirHtml } from '../../../i18n';
import { PRODUCTOS_ES } from '../../../i18n/productos.es';
import { COMUN_ES } from '../../../i18n/comun.es';
import FaqFichaEnlace from '../../../components/FaqFichaEnlace.astro';
import { partirTrasFaq } from '../../../lib/faq-ficha';
import { grafo, breadcrumbs, producto } from '../../../lib/jsonld';

// Las fichas de producto en español.
//
// Mismo patrón que /es/services/[slug]: el fragmento y los metadatos (wfPage,
// anti-FOUC) salen de los mismos ficheros que la versión inglesa, así que no pueden
// divergir. Lo único propio es el diccionario y el <head>.
//
// Solo se generan las que tienen diccionario. Un producto sin traducir no existe en
// /es/, no lleva hreflang y no entra en el sitemap.

const fragmentos = import.meta.glob('../../../contenido-migrado/products/*.html', {
  query: '?raw', import: 'default', eager: true,
});

export function getStaticPaths() {
  return items
    .filter((item) => PRODUCTOS_ES[item.slug])
    .map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const traduccion = PRODUCTOS_ES[item.slug]!;
const original = fragmentos['../../../contenido-migrado/products/' + item.slug + '.html'];
if (!original) throw new Error(`[i18n] sin fragmento para products/${item.slug}`);

const { html, traducidas, faltan } = traducirHtml(original as string, {
  ...COMUN_ES,
  ...traduccion.dic,
});

if (faltan.length) {
  console.warn(`\n  [i18n] /es/products/${item.slug} — ${traducidas} traducidas, ${faltan.length} SIN traducir:`);
  for (const f of faltan) console.warn(`         · ${f.slice(0, 110)}`);
}

// El enlace a la biblioteca va DENTRO de la lista de preguntas. Se parte el html
// YA TRADUCIDO: partir el original dejaria la mitad de la ficha sin traducir.
const faq = partirTrasFaq(html, 'es/products/' + item.slug);

const site = Astro.site!.href;
const ruta = `/es/products/${item.slug}/`;
const jsonLd = grafo(
  producto(site, {
    nombre: traduccion.nombre,
    descripcion: traduccion.description,
    ruta,
    imagen: item.ogImage ?? null,
  }),
  breadcrumbs(site, [['Nuestros productos', '/es/products/'], [traduccion.nombre, ruta]]),
);
---

<BaseLayout
  title={traduccion.title}
  description={traduccion.description}
  ogImage={item.ogImage ?? undefined}
  wfPage={item.wfPage ?? undefined}
  wfSite={item.wfSite ?? undefined}
  jsonLd={jsonLd}
>
  <Fragment set:html={faq.antes} />
  <FaqFichaEnlace tema={item.slug} idioma="es" />
  <Fragment set:html={faq.despues} />
</BaseLayout>
