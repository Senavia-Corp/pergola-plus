---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import items from '../../../contenido-migrado/project/_items.json';
import { traducirHtml } from '../../../i18n';
import { PROYECTOS_ES } from '../../../i18n/proyectos.es';
import { COMUN_ES } from '../../../i18n/comun.es';
import { grafo, breadcrumbs } from '../../../lib/jsonld';

// Las fichas de proyecto en español. Misma estructura que /es/services/[slug].
// Solo se generan las que tienen diccionario en PROYECTOS_ES.

const fragmentos = import.meta.glob('../../../contenido-migrado/project/*.html', {
  query: '?raw', import: 'default', eager: true,
});

export function getStaticPaths() {
  return items
    .filter((item) => PROYECTOS_ES[item.slug])
    .map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const traduccion = PROYECTOS_ES[item.slug]!;
const original = fragmentos['../../../contenido-migrado/project/' + item.slug + '.html'];
if (!original) throw new Error(`[i18n] sin fragmento para project/${item.slug}`);

const { html, traducidas, faltan } = traducirHtml(original as string, {
  ...COMUN_ES,
  ...traduccion.dic,
});

if (faltan.length) {
  console.warn(`\n  [i18n] /es/project/${item.slug} — ${traducidas} traducidas, ${faltan.length} SIN traducir:`);
  for (const f of faltan) console.warn(`         · ${f.slice(0, 110)}`);
}

const site = Astro.site!.href;
const ruta = `/es/project/${item.slug}/`;
const jsonLd = grafo(
  null,
  breadcrumbs(site, [['Proyectos destacados', '/es/project-gallery/'], [traduccion.nombre, ruta]], 'es'),
);
---

<BaseLayout
  title={traduccion.title}
  description={traduccion.description}
  ogImage={item.ogImage ?? undefined}
  wfPage={item.wfPage ?? undefined}
  wfSite={item.wfSite ?? undefined}
  jsonLd={jsonLd}
>
  <Fragment set:html={html} />
</BaseLayout>
