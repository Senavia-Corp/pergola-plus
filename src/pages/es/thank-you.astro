---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PROPIAS_ES } from '../../i18n/paginas-propias';
import { SITIO } from '../../lib/ajustes';
import { breadcrumbs, grafo } from '../../lib/jsonld';

const t = PROPIAS_ES.gracias;

// /es/thank-you — gemela de /thank-you. CODIGO DE AUTORIA PROPIA, se edita a mano.
//
// No pasa por traducirHtml() porque su gemela inglesa tampoco pasa por el
// transformador: las dos son .astro escritas a mano. Duplicar el marcado es aqui lo
// correcto y no lo que se hace en las paginas migradas — son 40 lineas, y el
// diccionario de una pagina que no existe en el CMS seria mas fragil que el marcado.
//
// El slug se queda en ingles, como en el resto del sitio.
//
// Importa mas de lo que parece: es donde aterriza TODO lead. Un visitante que
// rellena un formulario en espanol y cae en una pagina en ingles se queda sin saber
// que pasa despues, justo en el momento en que ya ha dado sus datos.
const ESCUDO_SVG =
  '<svg xmlns="http://www.w3.org/2000/svg" width="110" height="110" fill="none" viewBox="0 0 18 20" aria-hidden="true" focusable="false" class="ikonik-t882o">'
  + '<path fill="currentColor" d="m17.351 3.063-8-3a1.009 1.009 0 0 0-.7 0l-8 3A1 1 0 0 0 0 4a19.394 19.394 0 0 0 8.47 15.848 1 1 0 0 0 1.06 0A19.394 19.394 0 0 0 18 4a1 1 0 0 0-.649-.937Zm-3.644 4.644-5 5A1 1 0 0 1 8 13c-.033 0-.065 0-.1-.005a1.001 1.001 0 0 1-.733-.44l-2-3a1 1 0 0 1 1.664-1.11l1.323 1.986 4.138-4.138a1 1 0 0 1 1.414 1.414h.001Z" class="path-m3hdu"></path>'
  + '</svg>';
---

<BaseLayout
  noindex
  title={t.title}
  description={t.description}
  jsonLd={grafo(breadcrumbs(Astro.site!.href, [[t.h1, '/es/thank-you']], 'es'))}
  wfPage="69912a4897ff2b5abc998884"
  wfSite="6903b7794d5df3d76a7a2488"
>
  <div class="utility-page-wrap-copy">
    <div class="utility-page-content">
      <div set:html={ESCUDO_SVG} />

      <h1>{t.h1}</h1>

      <p id="ty-intro" class="ty-intro" data-quote={t.porFormulario.quote} data-contact={t.porFormulario.contact} data-footer={t.porFormulario.footer} data-estimador={t.porFormulario.estimador}>
        {t.intro}
      </p>

      <h2 class="ty-subtitulo">{t.subtitulo}</h2>
      <ol class="ty-pasos">
        <li>
          <strong>{t.pasos[0].fuerte}</strong> {t.pasos[0].texto}
        </li>
        <li>
          <!-- "Su ubicación" y no "su dirección": el estimador pide el codigo
               postal y nunca la calle, asi que prometer que revisamos una direccion
               que el visitante no ha dado era falso en ese camino. -->
          <strong>{t.pasos[1].fuerte}</strong> {t.pasos[1].texto}
        </li>
        <li>
          <strong>{t.pasos[2].fuerte}</strong> {t.pasos[2].texto}
        </li>
        <li>
          <strong>{t.pasos[3].fuerte}</strong> {t.pasos[3].texto}
        </li>
      </ol>

      <p class="ty-prisa">
        {t.prisa.antes}{' '}
        <a href={SITIO.tel.href}>{SITIO.tel.visible}</a> {t.prisa.entre}{' '}
        <a href={`mailto:${SITIO.correo}`}>{SITIO.correo}</a>{t.prisa.despues}
      </p>

      <div class="wrapper-buttons-center-form">
        <a href="/es/project-gallery" class="button w-button">{t.botones.obras}</a>
        <a href="/es/" class="button secundary w-button">{t.botones.inicio}</a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // El `?de=` lo pone el endpoint (303) y tambien el envio por fetch. Solo cambia UNA
  // frase, y su texto va en los data-* de #ty-intro (copia de la pagina, editable en
  // Sanity): sin JavaScript se queda la de por defecto, que es cierta para los cuatro
  // formularios. El mismo script en las dos gemelas.
  const FORMULARIOS = ['quote', 'contact', 'footer', 'estimador'];
  const de = new URLSearchParams(location.search).get('de');
  const intro = document.getElementById('ty-intro');
  const texto = intro && de && FORMULARIOS.includes(de) ? intro.dataset[de] : null;
  if (intro && texto) intro.textContent = texto;
</script>

<style>
  /* Mismos dos arreglos que la gemela inglesa. La barra de navegacion es fixed y
     mide 85px, y la hoja migrada centra este bloque dentro de `height: 100vh` sin
     descontarla: con el contenido midiendo mas que la ventana, el centrado lo
     empujaba hacia ARRIBA y el escudo de 110px se quedaba en 13 visibles. */
  .utility-page-wrap-copy {
    height: auto;
    min-height: 100vh;
    padding-top: calc(85px + 3rem);
    padding-bottom: 4rem;
  }

  .wrapper-buttons-center-form {
    gap: .75rem;
  }

  /* Copia de los estilos de /thank-you: las dos paginas son la misma plantilla. */
  .ty-intro {
    font-size: 20px;
    line-height: 1.5;
    max-width: 62ch;
    margin: 0 auto 2.5rem;
  }

  .ty-subtitulo {
    font-size: 22px;
    margin-bottom: 1rem;
  }

  .ty-pasos {
    text-align: left;
    max-width: 62ch;
    margin: 0 auto 2rem;
    padding-left: 1.4rem;
    line-height: 1.6;
  }

  .ty-pasos li {
    margin-bottom: 0.85rem;
  }

  .ty-prisa {
    max-width: 62ch;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  .ty-prisa a {
    color: var(--primary, #3a545b);
    font-weight: 600;
    text-decoration: underline;
  }
</style>
