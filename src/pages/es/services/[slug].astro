---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import items from '../../../contenido-migrado/services/_items.json';
import { traducirHtml } from '../../../i18n';
import { SERVICIOS_ES } from '../../../i18n/servicios.es';
import { COMUN_ES } from '../../../i18n/comun.es';
import FaqFichaEnlace from '../../../components/FaqFichaEnlace.astro';
import FaqPromovidas from '../../../components/FaqPromovidas.astro';
import ReseñasGoogle from '../../../components/ReseñasGoogle.astro';
import { partirTrasFaq, partirEnMarca, paresFaq, MARCA_RESENAS } from '../../../lib/faq-ficha';
import { grafo, breadcrumbs, servicio, faqPage } from '../../../lib/jsonld';
import { PROMOVIDAS } from '../../../data/faqs';
import { porId } from '../../../i18n/faqs.es';

// Las páginas de servicio en español.
//
// Misma idea que /es/[...ruta] pero sobre una COLECCIÓN: el fragmento y los
// metadatos (wfPage, anti-FOUC) salen de los mismos ficheros que la versión inglesa,
// así que no pueden divergir. Lo único propio es el diccionario y el <head>.
//
// Solo se generan las que tienen diccionario. Un servicio sin traducir no existe en
// /es/, no lleva hreflang y no entra en el sitemap.

const fragmentos = import.meta.glob('../../../contenido-migrado/services/*.html', {
  query: '?raw', import: 'default', eager: true,
});

export function getStaticPaths() {
  return items
    .filter((item) => SERVICIOS_ES[item.slug])
    .map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const traduccion = SERVICIOS_ES[item.slug]!;
const original = fragmentos['../../../contenido-migrado/services/' + item.slug + '.html'];
if (!original) throw new Error(`[i18n] sin fragmento para services/${item.slug}`);

const { html, traducidas, faltan } = traducirHtml(original as string, {
  ...COMUN_ES,
  ...traduccion.dic,
});

if (faltan.length) {
  console.warn(`\n  [i18n] /es/services/${item.slug} — ${traducidas} traducidas, ${faltan.length} SIN traducir:`);
  for (const f of faltan) console.warn(`         · ${f.slice(0, 110)}`);
}

// El enlace a la biblioteca va DENTRO de la lista de preguntas. Se parte el html
// YA TRADUCIDO: partir el original dejaria la mitad de la ficha sin traducir.
const faq = partirTrasFaq(html, 'es/services/' + item.slug);

// El hueco de `ReseñasGoogle` dentro de la banda `reviews`. Se corta `faq.despues` y
// no el html entero: la banda viene DESPUÉS del FAQ (…faq · projects · process ·
// service-areas · reviews). La marca la escribe el paso 6f de transformar.mjs, que es
// un .mjs y no puede importar ese .ts: `partirEnMarca` LANZA si no está, y esa es
// toda la comprobación que mantiene los dos ficheros de acuerdo.
const resenas = partirEnMarca(faq.despues, 'es/services/' + item.slug, MARCA_RESENAS);

// Los pares P/R que suben al FAQPage: SOLO los que hemos redactado y verificado
// nosotros, que sube FaqPromovidas desde la biblioteca. Las CINCO del fragmento
// migrado son copy de marketing del cliente y NO suben: el criterio es el ORIGEN y
// nunca el vocabulario — filtrar por palabras no funciona porque el español dice lo
// mismo más calmado y se escapa entero.
//
// `pergola-design-construction` no tiene entrada en PROMOVIDAS y eso es correcto:
// sus cinco preguntas son las cinco del cliente. Con la lista vacía, FaqPromovidas
// no pinta nada y el grafo se queda sin `FAQPage`.
const promovidas = PROMOVIDAS[item.slug] ?? [];
// `paresFaq` se sigue llamando por su ASERCIÓN —lanza si el markup migrado cambia—,
// no por su valor. Perder esa comprobación sería cambiar un defecto por otro.
const migradas = paresFaq(html, item.slug);
const pares = porId('es', promovidas);
if (migradas.length !== 5 || pares.length !== promovidas.length) {
  throw new Error(`[faq] es/services/${item.slug}: ${migradas.length} migradas y ${pares.length} promovidas; esperaba 5 y ${promovidas.length}`);
}

const site = Astro.site!.href;
const ruta = `/es/services/${item.slug}/`;
const jsonLd = grafo(
  servicio(site, { nombre: traduccion.nombre, descripcion: traduccion.description, ruta }),
  pares.length ? faqPage(pares) : null,
  breadcrumbs(site, [['Nuestros servicios', '/es/services/'], [traduccion.nombre, ruta]], 'es'),
);
---

<BaseLayout
  title={traduccion.title}
  description={traduccion.description}
  ogImage={item.ogImage ?? undefined}
  wfPage={item.wfPage ?? undefined}
  wfSite={item.wfSite ?? undefined}
  jsonLd={jsonLd}
>
  <Fragment set:html={faq.antes} />
  <FaqPromovidas tema={item.slug} idioma="es" />
  <FaqFichaEnlace tema={item.slug} idioma="es" />
  <Fragment set:html={resenas.antes} />
  {/* DENTRO de la banda `reviews`, entre su titular y el enlace a testimonios. Como
      banda propia serían dos claras seguidas antes del CTA del pie y check:ritmo lo
      cazaría. Ver MARCA_RESENAS en src/lib/faq-ficha.ts.

      `embebido` porque la banda YA trae titular: sin él salían dos titulares
      seguidos diciendo lo mismo y un panel crema dentro de una banda blanca. */}
  <ReseñasGoogle embebido />
  <Fragment set:html={resenas.despues} />
</BaseLayout>
