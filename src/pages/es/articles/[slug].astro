---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import items from '../../../contenido-migrado/articles/_items.json';
import { traducirHtml } from '../../../i18n';
import { ARTICULOS_ES } from '../../../i18n/articulos.es';
import { COMUN_ES } from '../../../i18n/comun.es';
import { grafo, breadcrumbs } from '../../../lib/jsonld';

// Los artículos legales en español. Solo se genera el que tiene diccionario en
// ARTICULOS_ES — hoy, únicamente el aviso de privacidad. El porqué está escrito en
// src/i18n/articulos.es.ts.

const fragmentos = import.meta.glob('../../../contenido-migrado/articles/*.html', {
  query: '?raw', import: 'default', eager: true,
});

export function getStaticPaths() {
  return items
    .filter((item) => ARTICULOS_ES[item.slug])
    .map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const traduccion = ARTICULOS_ES[item.slug]!;
const original = fragmentos['../../../contenido-migrado/articles/' + item.slug + '.html'];
if (!original) throw new Error(`[i18n] sin fragmento para articles/${item.slug}`);

const { html, traducidas, faltan } = traducirHtml(original as string, {
  ...COMUN_ES,
  ...traduccion.dic,
});

if (faltan.length) {
  console.warn(`\n  [i18n] /es/articles/${item.slug} — ${traducidas} traducidas, ${faltan.length} SIN traducir:`);
  for (const f of faltan) console.warn(`         · ${f.slice(0, 110)}`);
}

const site = Astro.site!.href;
const ruta = `/es/articles/${item.slug}/`;
const jsonLd = grafo(null, breadcrumbs(site, [[traduccion.nombre, ruta]], 'es'));
---

<BaseLayout
  title={traduccion.title}
  description={traduccion.description}
  ogImage={item.ogImage ?? undefined}
  wfPage={item.wfPage ?? undefined}
  wfSite={item.wfSite ?? undefined}
  jsonLd={jsonLd}
>
  <Fragment set:html={html} />
</BaseLayout>
