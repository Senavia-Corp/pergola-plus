---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITIO } from '../../lib/ajustes';
import ReseñasGoogle from '../../components/ReseñasGoogle.astro';
import htmlOriginal from '../../contenido-migrado/estaticas/index.html?raw';
import { traducirHtml } from '../../i18n';
import { HOME_ES } from '../../i18n/home.es';
// Los alt de las 10 miniaturas de la banda de blog: son atributos, no nodos de texto,
// y `traducirHtml` NO reporta los atributos que no encuentra. Ver scripts/lib/miniaturas.mjs.
import { MINIATURAS_ES } from '../../../scripts/lib/miniaturas.mjs';
import { grafo, localBusiness, sitioWeb } from '../../lib/jsonld';
import { partirEnMarca, MARCA_RESENAS } from '../../lib/faq-ficha';
import { FUENTE, paginaDe, fragmentoEstatica, posterHero } from '../../lib/sanity/fuente.mjs';

// Home en español.
//
// NO es una copia del HTML: se reutiliza el markup del export y se sustituyen
// solo los nodos de texto (ver src/i18n/index.ts). Con eso los `data-w-id`, el
// bloque anti-FOUC, las imágenes y las clases quedan intactos, así que las
// interacciones IX2 funcionan igual que en la home inglesa — y cualquier cambio
// de maquetación en el original llega solo a las dos versiones.
//
// wfPage/wfSite son los MISMOS que la home inglesa a propósito: son la llave con
// la que IX2 resuelve los ids page-scoped (los que llevan "|"), y esta página
// usa exactamente esos elementos.

// Con PP_FUENTE=sanity, el texto español es el del documento page-index (sin diccionario).
const doc = FUENTE === 'sanity' ? paginaDe('/') : null;
const { html, traducidas, faltan } = doc
  ? { html: fragmentoEstatica(doc, 'es'), traducidas: 0, faltan: [] as string[] }
  : traducirHtml(htmlOriginal, { ...HOME_ES, ...MINIATURAS_ES });

// Se parte sobre el HTML YA TRADUCIDO: es el que se sirve, y `traducirHtml`
// conserva los comentarios. `partirEnMarca` LANZA si la marca no esta.
const resenas = partirEnMarca(html, 'es/', MARCA_RESENAS);

// El MISMO nodo de negocio que la home inglesa, con el mismo @id: es el mismo
// negocio, no dos. Lo que cambia es el idioma de la pagina, no el telefono.
const jsonLd = grafo(localBusiness(Astro.site!.href), sitioWeb(Astro.site!.href, 'es'));

// El build avisa de lo que se quedó sin traducir en vez de dejarlo pasar en
// silencio. No rompe la build: una cadena sin traducir sale en inglés, que es
// degradado aceptable; una build rota, no.
if (faltan.length) {
  console.warn(`\n  [i18n] /es/ — ${traducidas} cadenas traducidas, ${faltan.length} SIN traducir:`);
  for (const f of faltan) console.warn(`         · ${f.slice(0, 100)}`);
}

---

<BaseLayout
  title={doc ? doc.seo.titulo.es : "Pergola Plus Florida | Pérgolas a medida y vida al aire libre"}
  {/* 158 caracteres. Estaba en 194 y Google corta alrededor de 160: la frase que
      cerraba —"Presupuesto gratis"— no llegaba a leerse. */}
  description={doc ? doc.seo.descripcion?.es : "Contratista de pérgolas con licencia en el sur de Florida. Pérgolas de lamas motorizadas, cubiertas de patio y cerramientos a medida, con presupuesto gratis."}
  wfPage="6903b77b4d5df3d76a7a25a2"
  wfSite="6903b7794d5df3d76a7a2488"
  jsonLd={jsonLd}
  ogImage="/images/og-pergola-plus-florida.jpg"
  preloadImagen={doc ? posterHero() : "/images/hero-pergola-plus-florida-poster.avif"}
>
  {/* Las mismas reseñas que la home inglesa, y en el MISMO sitio: dentro de la
      banda `reviews`, entre su titular y el botón a testimonios. Esta página no
      pasa por [...ruta].astro —es de autoría propia— así que lo monta ella.

      Iba al final del documento y por eso la home enseñaba DOS secciones de
      Reviews: la blanca de Webflow vacía a media página y esta, crema, mucho más
      abajo. `embebido` la mete dentro y deja una sola.

      Las reseñas salen en el idioma en que las escribió cada cliente, también
      aquí: traducir un testimonio lo convierte en algo que esa persona no dijo.
      Solo se traducen los rótulos (src/i18n/resenas.ts). */}
  <Fragment set:html={resenas.antes} />
  <ReseñasGoogle embebido />
  <Fragment set:html={resenas.despues} />

  {/* Aviso honesto: parte del sitio sigue en inglés. Vale más decirlo que dejar
      que el visitante lo descubra al segundo clic.

      Se actualiza cuando cambia lo que está traducido, y se retira del todo cuando
      no quede nada en inglés. Medido sobre dist/ el 18-oct-2026: de las 109 rutas
      inglesas, 108 tienen gemela en /es/ —incluidos los 21 artículos y el
      calculador—; la única sin traducir era /articles/terms-of-service. El texto
      decía que blog y calculador seguían en inglés cuando ya no era verdad (GH-009).
      21-oct-2026: los términos tienen traducción de cortesía (decisión del usuario,
      ver src/i18n/articulos.es.ts), así que ya no queda nada en inglés. */}
  <section class="aviso-idioma">
    <div class="w-layout-blockcontainer container w-container">
      <p>
        Está en español todo el sitio: <a href="/es/products/">productos</a>,
        <a href="/es/services/">servicios</a>,
        <a href="/es/about-us/where-we-work/">zonas donde trabajamos</a>,
        <a href="/es/project-gallery/">proyectos</a>,
        <a href="/es/resources/blog/">blog</a>,
        <a href="/es/project-estimator/">calculador de presupuesto</a>, las páginas de
        contacto y los <a href="/articles/terms-of-service/">términos y condiciones</a>,
        en traducción de cortesía. Si prefiere que le atendamos en español, escríbanos por
        <a href={SITIO.tel.wa} target="_blank" rel="noopener">WhatsApp</a>
        o llámenos al <a href={SITIO.tel.href}>{SITIO.tel.visible}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .aviso-idioma {
    background-color: var(--secundary);
    border-top: 1px solid #3a545b26;
    padding: 1.25rem 2rem;
  }

  .aviso-idioma p {
    color: var(--terceary);
    max-width: 780px;
    margin: 0 auto;
    font-size: 13.5px;
    line-height: 1.5;
    text-align: center;
  }

  .aviso-idioma a {
    color: var(--primary);
    font-weight: 600;
    text-decoration: underline;
  }
</style>
