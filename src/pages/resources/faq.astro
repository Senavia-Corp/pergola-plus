---
/**
 * La biblioteca de preguntas frecuentes. CODIGO DE AUTORIA PROPIA.
 *
 * Ya NO lo escribe scripts/generar-paginas.mjs: la ruta esta en su Set MANUALES.
 * El generador sigue produciendo el fragmento migrado en
 * src/contenido-migrado/estaticas/resources__faq.html —es la unica copia en el
 * repo del markup original de las 10 preguntas, util para diffear— pero no pisa
 * este archivo.
 *
 * La gemela española es src/pages/es/resources/faq.astro y monta el MISMO
 * componente: es lo que hace que los `data-w-id` de las dos coincidan sin
 * mantener nada a mano, que es lo que exige check:i18n.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqBiblioteca from '../../components/FaqBiblioteca.astro';
import { WF_PAGE, WF_SITE } from '../../data/faqs';
import { destacadas } from '../../i18n/faqs.es';
import { grafo, collectionPage, faqPage, breadcrumbs } from '../../lib/jsonld';

const TITULO = 'Pergola FAQ Library | Permits, Costs & Materials';
const DESCRIPCION =
  'Every question we get asked about pergolas, screens, pavers and outdoor construction in South Florida — permits, wind load, pricing, materials and timelines.';

const site = Astro.site!;
const url = new URL('/resources/faq', site).href;
---

<BaseLayout
  title={TITULO}
  description={DESCRIPCION}
  wfPage={WF_PAGE}
  wfSite={WF_SITE}
  jsonLd={grafo(
    collectionPage({ url, nombre: 'Pergola Plus FAQ Library', descripcion: DESCRIPCION, idioma: 'en-US' }),
    faqPage(destacadas('en')),
    breadcrumbs(site.href, [['FAQ', '/resources/faq']]),
  )}
>
  <FaqBiblioteca
    titulo="Pergola FAQs"
    intro="Search every question we get asked about pergolas, motorized louvered roofs, screens, pavers and outdoor construction in South Florida — permits, wind load, pricing, materials and how long the work takes."
  />
</BaseLayout>
