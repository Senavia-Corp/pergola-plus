---
import BaseLayout from '../../layouts/BaseLayout.astro';
import htmlRepo from '../../contenido-migrado/estaticas/resources__warranties.html?raw';
import { FUENTE, paginaDe, fragmentoEstatica } from '../../lib/sanity/fuente.mjs';
import { grafo, localBusiness, breadcrumbs } from '../../lib/jsonld';

const site = Astro.site!.href;
const jsonLd = grafo(breadcrumbs(site, [["Warranties","/resources/warranties"]]));

// Con PP_FUENTE=sanity, el documento page-<id> pintado con su plantilla
// (src/plantillas/page-<id>.html); si no, el fragmento migrado.
const doc = FUENTE === 'sanity' ? paginaDe("/resources/warranties") : null;
const html = doc ? fragmentoEstatica(doc, 'en') : htmlRepo;

// Generado por scripts/generar-paginas.mjs desde el HTML real de /resources/warranties.
// NO editar a mano. El nav y el footer los pone BaseLayout.
---

<BaseLayout
  title={doc ? doc.seo.titulo.en : "Warranty Information | Pergola Plus Florida"}
  description={doc ? doc.seo.descripcion?.en : "Warranty coverage on our FORTE, Equinox, Renaissance, Fenetex and MaestroShield systems, and what each one actually protects."}
  wfSite="6903b7794d5df3d76a7a2488"
  jsonLd={jsonLd}
>
  <Fragment set:html={html} />
</BaseLayout>
