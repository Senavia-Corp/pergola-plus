---
import BaseLayout from '../layouts/BaseLayout.astro';

// /thank-you — CODIGO DE AUTORIA PROPIA. Se edita a mano.
//
// Nacio del fragmento migrado y se reescribio en la Fase 2. El original decia
// "Our team is reviewing your project details and will contact you shortly", que es
// verdad a medias y no dice nada util: ni cuando, ni por que via, ni que hacer si
// corre prisa. Y no traia <h1>: la pagina a la que aterriza TODO lead tenia como
// encabezado principal un <h2> suelto.
//
// Se conservan las clases del CSS migrado (`utility-page-wrap-copy`,
// `utility-page-content`, `button w-button`) para que se vea igual que el resto.
//
// Esta pagina es estatica, asi que el `?de=` de la URL lo lee un script minusculo
// al final: sin JavaScript se ve el texto por defecto, que es cierto para los tres
// formularios. La diferencia importa —"revisamos los detalles de tu proyecto" es
// falso para quien solo se ha suscrito en el pie— pero no vale una peticion al
// servidor.
const ESCUDO_SVG =
  '<svg xmlns="http://www.w3.org/2000/svg" width="110" height="110" fill="none" viewBox="0 0 18 20" aria-hidden="true" focusable="false" class="ikonik-t882o">'
  + '<path fill="currentColor" d="m17.351 3.063-8-3a1.009 1.009 0 0 0-.7 0l-8 3A1 1 0 0 0 0 4a19.394 19.394 0 0 0 8.47 15.848 1 1 0 0 0 1.06 0A19.394 19.394 0 0 0 18 4a1 1 0 0 0-.649-.937Zm-3.644 4.644-5 5A1 1 0 0 1 8 13c-.033 0-.065 0-.1-.005a1.001 1.001 0 0 1-.733-.44l-2-3a1 1 0 0 1 1.664-1.11l1.323 1.986 4.138-4.138a1 1 0 0 1 1.414 1.414h.001Z" class="path-m3hdu"></path>'
  + '</svg>';
---

<BaseLayout
  title="Thank You — We Received Your Request | Pergola Plus Florida"
  description="Your request reached our team. Here is what happens next, how soon we reply, and how to reach us if your project is time-sensitive."
  wfPage="69912a4897ff2b5abc998884"
  wfSite="6903b7794d5df3d76a7a2488"
>
  <div class="utility-page-wrap-copy">
    <div class="utility-page-content">
      <div set:html={ESCUDO_SVG} />

      <h1>Thank you — we have your request.</h1>

      <p id="ty-intro" class="ty-intro">
        A member of our design team is reviewing what you sent.
      </p>

      <h2 class="ty-subtitulo">What happens next</h2>
      <ol class="ty-pasos">
        <li>
          <strong>Within one business day</strong> we reply by email to confirm we
          received your request and to ask anything we still need.
        </li>
        <li>
          <strong>We check your address</strong> against the counties we build in —
          Miami-Dade, Broward and Palm Beach — and against local permitting and
          wind-load requirements.
        </li>
        <li>
          <strong>We propose a site visit</strong> so we can measure, look at the
          structure we would attach to, and talk through options in person.
        </li>
        <li>
          <strong>You get a written proposal</strong> with the system, the scope and
          the price. No obligation.
        </li>
      </ol>

      <p class="ty-prisa">
        In a hurry, or would you rather talk it through now? Call
        <a href="tel:+15617108363">(561) 710-8363</a> during business hours
        (Mon–Fri, 8:00 AM – 5:00 PM) or write to
        <a href="mailto:info@pergolaplusflorida.com">info@pergolaplusflorida.com</a>.
      </p>

      <div class="wrapper-buttons-center-form">
        <a href="/project-gallery" class="button w-button">See our recent work</a>
        <a href="/" class="button secundary w-button">Back to the main page</a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // El `?de=` lo pone el endpoint (303) y tambien el envio por fetch. Solo cambia
  // UNA frase: sin JavaScript se queda la de por defecto, que es cierta para los
  // tres formularios.
  const POR_FORMULARIO = {
    quote: 'A member of our design team is reviewing your project details.',
    contact: 'A member of our team is reading your message.',
    footer: 'You are on the list — we will send you our outdoor living updates.',
  };
  const de = new URLSearchParams(location.search).get('de');
  const intro = document.getElementById('ty-intro');
  if (intro && de && POR_FORMULARIO[de]) intro.textContent = POR_FORMULARIO[de];
</script>

<style>
  /* Propio, no migrado: el fragmento original solo tenia un parrafo. */
  .ty-intro {
    font-size: 20px;
    line-height: 1.5;
    max-width: 62ch;
    margin: 0 auto 2.5rem;
  }

  .ty-subtitulo {
    font-size: 22px;
    margin-bottom: 1rem;
  }

  .ty-pasos {
    text-align: left;
    max-width: 62ch;
    margin: 0 auto 2rem;
    padding-left: 1.4rem;
    line-height: 1.6;
  }

  .ty-pasos li {
    margin-bottom: 0.85rem;
  }

  .ty-prisa {
    max-width: 62ch;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  .ty-prisa a {
    color: var(--primary, #3a545b);
    font-weight: 600;
    text-decoration: underline;
  }
</style>
