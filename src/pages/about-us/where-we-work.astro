        <div class="w-embed w-script">
          <style is:inline>
/* SOLO DESKTOP: activa el sistema de imágenes */
@media screen and (min-width: 768px) {
  .locations-left{
    position: relative;
    z-index: 2;
  }
  .locations-right{
    opacity: 0;
    pointer-events: none;
    transition: opacity 250ms ease;
    z-index: 1;
  }
  .locations-right.is-active{
    opacity: 1;
    pointer-events: auto;
  }
}
</style>
          <script is:inline>
document.addEventListener("DOMContentLoaded", () => {
  // SOLO desktop
  const desktopMQ = window.matchMedia("(min-width: 768px)");
  if (!desktopMQ.matches) return;
  const triggers = Array.from(document.querySelectorAll(".locations-left[data-county]"));
  const targets  = Array.from(document.querySelectorAll(".locations-right[data-county-image]"));
  if (!triggers.length || !targets.length) return;
  function activate(id) {
    targets.forEach(t => t.classList.toggle("is-active", t.getAttribute("data-county-image") === id));
    triggers.forEach(tr => tr.classList.toggle("is-active", tr.getAttribute("data-county") === id));
  }
  // Default: el primero activo
  activate(triggers[0].getAttribute("data-county"));
  triggers.forEach(tr => {
    const id = tr.getAttribute("data-county");
    tr.addEventListener("mouseenter", () => activate(id));
    tr.addEventListener("focus", () => activate(id));
    if (!tr.hasAttribute("tabindex")) tr.setAttribute("tabindex", "0");
  });
});
</script>
