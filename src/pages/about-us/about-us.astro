---
import BaseLayout from '../../layouts/BaseLayout.astro';
import html from '../../contenido-migrado/estaticas/about-us__about-us.html?raw';
import ReseñasGoogle from '../../components/ReseñasGoogle.astro';
import { partirEnMarca, MARCA_RESENAS } from '../../lib/faq-ficha';
import { grafo, localBusiness, breadcrumbs } from '../../lib/jsonld';

const site = Astro.site!.href;
const jsonLd = grafo(breadcrumbs(site, [["About Us","/about-us/about-us"]]));

const resenas = partirEnMarca(html, "/about-us/about-us", MARCA_RESENAS);

// Generado por scripts/generar-paginas.mjs desde el HTML real de /about-us/about-us.
// NO editar a mano. El nav y el footer los pone BaseLayout.
---

<BaseLayout
  title="About Pergola Plus Florida | Licensed Contractor"
  description="Who we are: a licensed and insured South Florida contractor building custom pergolas and outdoor structures for over ten years."
  wfPage="698a90bb670f759b2b5b60f1"
  wfSite="6903b7794d5df3d76a7a2488"
  jsonLd={jsonLd}
>
  <Fragment set:html={resenas.antes} />
  {/* DENTRO de la banda `reviews`, entre su titular y el boton a
      testimonios. `embebido` porque la banda YA trae titular: como banda
      propia salian dos secciones de Reviews, la de Webflow vacia y otra
      debajo con las tarjetas. */}
  <ReseñasGoogle embebido />
  <Fragment set:html={resenas.despues} />
</BaseLayout>
