---
import BaseLayout from '../../layouts/BaseLayout.astro';
import html from '../../contenido-migrado/estaticas/about-us__industries-we-serve.html?raw';
import ReseñasGoogle from '../../components/ReseñasGoogle.astro';
import { partirEnMarca, MARCA_RESENAS } from '../../lib/faq-ficha';
import { grafo, localBusiness, breadcrumbs } from '../../lib/jsonld';

const site = Astro.site!.href;
const jsonLd = grafo(breadcrumbs(site, [["Industries We Serve","/about-us/industries-we-serve"]]));

const resenas = partirEnMarca(html, "/about-us/industries-we-serve", MARCA_RESENAS);

// Generado por scripts/generar-paginas.mjs desde el HTML real de /about-us/industries-we-serve.
// NO editar a mano. El nav y el footer los pone BaseLayout.
---

<BaseLayout
  title="Industries We Serve | Pergola Plus Florida"
  description="Residential, hospitality, commercial and property management projects across Miami-Dade, Broward and Palm Beach counties."
  wfPage="698a9121e6b67d5933c8f6e1"
  wfSite="6903b7794d5df3d76a7a2488"
  jsonLd={jsonLd}
>
  <Fragment set:html={resenas.antes} />
  {/* DENTRO de la banda `reviews`, entre su titular y el boton a
      testimonios. `embebido` porque la banda YA trae titular: como banda
      propia salian dos secciones de Reviews, la de Webflow vacia y otra
      debajo con las tarjetas. */}
  <ReseñasGoogle embebido />
  <Fragment set:html={resenas.despues} />
</BaseLayout>
