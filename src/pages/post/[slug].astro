---
/**
 * Detalle de un articulo del blog. CODIGO DE AUTORIA PROPIA.
 *
 * Ya NO lo escribe scripts/generar-detalle.mjs: la coleccion `post` lleva
 * `paginaPropia: true`. El generador sigue produciendo los 21 fragmentos y el
 * _items.json, pero no pisa este archivo.
 *
 * Del fragmento migrado se aprovecha SOLO el texto del articulo (ver
 * src/lib/articulo.ts). Lo demas se descarta a proposito:
 *
 *  - La cabecera traia `opacity:0` EN LINEA y los posts no llevan bloque
 *    anti-FOUC (medido: 4 inline, 0 bloques). Sin JavaScript el h1 y la imagen
 *    principal eran invisibles en los 21 articulos.
 *  - La barra lateral eran 10 tarjetas HARDCODEADAS E IDENTICAS en los 21 posts:
 *    7,9 KB de los 17 KB del fragmento y 210 enlaces internos casi duplicados.
 *    La sustituyen el indice y 3 relacionados de verdad.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import items from '../../contenido-migrado/post/_items.json';
import TarjetaPost from '../../components/TarjetaPost.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import { posts, postsDe, fechaLarga, fechaIso, ORGANIZACION } from '../../lib/blog';
import { prepararArticulo } from '../../lib/articulo';
import '../../styles/blog.css';

const fragmentos = import.meta.glob('../../contenido-migrado/post/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
});

export function getStaticPaths() {
  return items.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const bruto = fragmentos['../../contenido-migrado/post/' + item.slug + '.html'] as string | undefined;
if (!bruto) throw new Error('sin fragmento para post/' + item.slug);

// Los metadatos (categoria, fecha, tiempo de lectura) NO estan en _items.json:
// solo trae slug/title/description/og/wf. Salen del CSV, via src/lib/blog.ts.
const i = posts.findIndex((p) => p.slug === item.slug);
if (i === -1) throw new Error(`[post] ${item.slug} no esta en el CSV del CMS`);
const post = posts[i]!;

const { cuerpo, indice } = prepararArticulo(bruto);

// Mismo orden que el listado, para que anterior/siguiente sea coherente con lo
// que el lector acaba de ver.
const anterior = posts[i - 1];
const siguiente = posts[i + 1];

/** Tres de la misma categoria. Si no llegan, se completa con los mas recientes. */
const relacionados = [
  ...postsDe(post.categoria.slug).filter((p) => p.slug !== post.slug),
  ...posts.filter((p) => p.slug !== post.slug && p.categoria.slug !== post.categoria.slug),
].slice(0, 3);

const site = Astro.site!;
const url = new URL(`/post/${post.slug}`, site).href;
const urlBlog = new URL('/resources/blog', site).href;
const urlCategoria = new URL(`/resources/blog/${post.categoria.slug}`, site).href;

const migas = [
  { nombre: 'Home', url: new URL('/', site).href, href: '/' },
  { nombre: 'Blog', url: urlBlog, href: '/resources/blog' },
  { nombre: post.categoria.nombre, url: urlCategoria, href: `/resources/blog/${post.categoria.slug}` },
  { nombre: post.titulo, url, href: null },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${url}#post`,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    url,
    headline: post.titulo,
    description: post.descripcionSeo || post.resumen,
    image: new URL(post.principal.src, site).href,
    articleSection: post.categoria.nombre,
    datePublished: post.publicado.toISOString(),
    dateModified: post.actualizado.toISOString(),
    wordCount: post.palabras,
    timeRequired: `PT${post.minutos}M`,
    inLanguage: 'en-US',
    // No hay campo de autor en ninguno de los 14 CSV del export. La organizacion
    // es un autor valido y honesto; inventarse una persona no lo seria.
    author: ORGANIZACION,
    publisher: ORGANIZACION,
    isPartOf: { '@type': 'Blog', '@id': `${urlBlog}#blog` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: migas.map((m, n) => ({
      '@type': 'ListItem',
      position: n + 1,
      name: m.nombre,
      item: m.url,
    })),
  },
];
---

<BaseLayout
  title={item.title}
  description={item.description ?? undefined}
  ogImage={item.ogImage ?? undefined}
  wfPage={item.wfPage ?? undefined}
  wfSite={item.wfSite ?? undefined}
  ogType="article"
  jsonLd={jsonLd}
>
  {/* Decoracion pura: el avance sale del scroll en CSS, sin JS. */}
  <div class="pp-progreso" aria-hidden="true"><span></span></div>

  <article class="pp-articulo">
    <div class="pp-wrap pp-art-cabecera">
      <nav class="pp-migas" aria-label="Breadcrumb">
        <ol>
          {
            migas.map((m) => (
              <li>
                {m.href ? <a href={m.href}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}
              </li>
            ))
          }
        </ol>
      </nav>

      <a href={`/resources/blog/${post.categoria.slug}`} class="pp-etiqueta pp-etiqueta-enlace">
        {post.categoria.nombre}
      </a>

      <h1>{post.titulo}</h1>
      <p class="pp-art-entradilla">{post.resumen}</p>

      <div class="pp-art-meta">
        <span class="pp-dato">
          <time datetime={fechaIso(post.publicado)}>{fechaLarga(post.publicado)}</time>
        </span>
        <span class="pp-dato">{post.minutos} min read</span>
        <span class="pp-dato">{post.palabras.toLocaleString('en-US')} words</span>
      </div>
    </div>

    <div class="pp-wrap pp-art-cabecera" style="padding-top:0">
      <figure class="pp-art-hero">
        <img
          src={post.principal.src}
          alt={post.altPrincipal}
          width={post.principal.width ?? undefined}
          height={post.principal.height ?? undefined}
          fetchpriority="high"
        />
      </figure>
    </div>

    <div class="pp-wrap pp-articulo-grid">
      {
        indice.length > 2 && (
          <aside class="pp-indice" id="pp-indice">
            {/* <details> SIN `open`: en movil arranca plegado, que si no son 15
                enlaces por delante del articulo. En escritorio el CSS fuerza la
                lista visible y desactiva el plegado, asi que se comporta como un
                indice fijo normal. Todo sin JavaScript. */}
            <details>
              <summary class="pp-indice-titulo">On this page</summary>
              <ol>
                {indice.map((e) => (
                  <li class={e.nivel === 3 ? 'pp-indice-h3' : undefined}>
                    <a href={`#${e.id}`}>{e.texto}</a>
                  </li>
                ))}
              </ol>
            </details>
          </aside>
        )
      }

      <div class="pp-prosa" set:html={cuerpo} />
    </div>

    {
      relacionados.length > 0 && (
        <section class="pp-wrap pp-relacionados" aria-labelledby="pp-relacionados-t">
          <div class="title-deco">Keep reading</div>
          <h2 id="pp-relacionados-t">More on {post.categoria.nombre}</h2>
          <ul class="pp-grid">
            {relacionados.map((p) => (
              <li>
                <TarjetaPost post={p} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      (anterior || siguiente) && (
        <nav class="pp-wrap pp-post-nav" aria-label="More articles">
          {anterior ? (
            <a href={`/post/${anterior.slug}`} rel="prev">
              <span class="pp-dato">Previous</span>
              <span class="pp-post-nav-titulo">{anterior.titulo}</span>
            </a>
          ) : (
            <span />
          )}
          {siguiente ? (
            <a href={`/post/${siguiente.slug}`} rel="next" class="pp-post-nav-sig">
              <span class="pp-dato">Next</span>
              <span class="pp-post-nav-titulo">{siguiente.titulo}</span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </article>

  {/* El fragmento migrado traia este bloque y al quedarme solo con el texto los 21
      articulos se quedaron sin cierre de conversion. Vuelve, y con los destinos
      ya arreglados. */}
  <CtaFinal />
</BaseLayout>

<script>
  // Scroll-spy del indice: marca la seccion que se esta leyendo.
  //
  // Es MEJORA, no requisito: sin este script el indice sigue siendo una lista de
  // enlaces de ancla que funciona perfectamente. Por eso no hay ningun estado
  // inicial que dependa de JS.
  const indice = document.getElementById('pp-indice');
  if (indice) {
    const enlaces = new Map<string, HTMLAnchorElement>();
    for (const a of indice.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')) {
      enlaces.set(decodeURIComponent(a.hash.slice(1)), a);
    }

    const secciones = [...enlaces.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    let actual: HTMLAnchorElement | null = null;
    const marcar = (id: string) => {
      const a = enlaces.get(id);
      if (!a || a === actual) return;
      actual?.removeAttribute('aria-current');
      a.setAttribute('aria-current', 'true');
      actual = a;
      // Mantener visible la entrada activa cuando el indice tiene scroll propio.
      if (indice.scrollHeight > indice.clientHeight) {
        a.scrollIntoView({ block: 'nearest' });
      }
    };

    // El margen superior descarta la franja tapada por el nav fijo; el inferior
    // deja "activa" la ultima seccion visible en vez de la que asoma abajo.
    const io = new IntersectionObserver(
      (entradas) => {
        const visibles = entradas.filter((e) => e.isIntersecting);
        if (visibles.length === 0) return;
        visibles.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        marcar(visibles[0]!.target.id);
      },
      { rootMargin: '-110px 0px -65% 0px', threshold: 0 },
    );

    for (const s of secciones) io.observe(s);
  }
</script>
