---
import BaseLayout from '../layouts/BaseLayout.astro';
import htmlRepo from '../contenido-migrado/estaticas/products.html?raw';
import { FUENTE, paginaDe, fragmentoEstatica } from '../lib/sanity/fuente.mjs';
import { grafo, localBusiness, breadcrumbs } from '../lib/jsonld';

const site = Astro.site!.href;
const jsonLd = grafo(breadcrumbs(site, [["Our Products","/products"]]));

// Con PP_FUENTE=sanity, el documento page-<id> pintado con su plantilla
// (src/plantillas/page-<id>.html); si no, el fragmento migrado.
const doc = FUENTE === 'sanity' ? paginaDe("/products") : null;
const html = doc ? fragmentoEstatica(doc, 'en') : htmlRepo;

// Generado por scripts/generar-paginas.mjs desde el HTML real de /products.
// NO editar a mano. El nav y el footer los pone BaseLayout.
---

<BaseLayout
  title={doc ? doc.seo.titulo.en : "Luxury Pergolas & Outdoor Shade | Pergola Plus Florida"}
  description={doc ? doc.seo.descripcion?.en : "Custom motorized louvered pergolas, insulated roof systems, cabanas & outdoor structures. Engineered for South Florida. Licensed CGC1539940."}
  wfSite="6903b7794d5df3d76a7a2488"
  jsonLd={jsonLd}
>
  <Fragment set:html={html} />
</BaseLayout>
