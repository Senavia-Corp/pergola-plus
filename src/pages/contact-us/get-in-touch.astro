---
/**
 * Pagina de contacto. CODIGO DE AUTORIA PROPIA.
 *
 * Ya NO la escribe scripts/generar-paginas.mjs: la ruta esta en su Set MANUALES.
 * El generador sigue produciendo el fragmento migrado en
 * src/contenido-migrado/estaticas/contact-us__get-in-touch.html —la copia en el repo
 * del markup original, util para diffear— pero no pisa este archivo.
 *
 * El cuerpo es el MISMO componente que la gemela española (PaginaContacto.astro):
 * el diseño y el formulario no pueden divergir entre idiomas.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PaginaContacto from '../../components/PaginaContacto.astro';
import { CONTACTO_EN } from '../../i18n/contacto';
import { grafo, localBusiness, breadcrumbs } from '../../lib/jsonld';

const site = Astro.site!.href;
const jsonLd = grafo(
  localBusiness(site),
  breadcrumbs(site, [['Contact Us', '/contact-us/get-in-touch']]),
);
---

<BaseLayout
  title="Contact Pergola Plus Florida | Boca Raton, FL"
  description="Call, email or write to our Boca Raton team about pergolas, patio covers and screen enclosures anywhere in South Florida."
  wfPage="698a91c07b51ec699ca6f4f8"
  wfSite="6903b7794d5df3d76a7a2488"
  jsonLd={jsonLd}
>
  <PaginaContacto copia={CONTACTO_EN} />
</BaseLayout>
