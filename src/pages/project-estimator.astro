---
import BaseLayout from '../layouts/BaseLayout.astro';
import Estimador from '../components/Estimador.astro';
import ReseñasGoogle from '../components/ReseñasGoogle.astro';
import { ESTIMADOR_EN } from '../i18n/estimador';
import { grafo, breadcrumbs } from '../lib/jsonld';

// /project-estimator — el cuerpo vive en src/components/Estimador.astro, con los
// precios. Aqui solo quedan el <head> y las migas, que son lo unico que cambia entre
// esta pagina y su gemela /es/project-estimator.

const jsonLd = grafo(breadcrumbs(Astro.site!.href, [['Project Estimator', '/project-estimator']]));
---

<BaseLayout
  title="Pergola Cost Estimator | Pergola Plus Florida"
  description="Estimate your custom pergola or patio cover investment in South Florida using our published 2026 installed price ranges. No contact details required."
  jsonLd={jsonLd}
>
  <Estimador t={ESTIMADOR_EN} />
  {/* Va DESPUES del calculador, no antes: quien llega aqui viene a ver precios.
      Las resenas son lo que le ayuda a decidir una vez tiene la cifra. */}
  <ReseñasGoogle />
</BaseLayout>
