                      </div>
                      <div class="box-detail-projects">
                        <div class="w-dyn-bind-empty"></div>
                      </div>
                    </div>
                    <h3 class="projects-card-h3 w-dyn-bind-empty"></h3>
                    <div class="projects-card-text w-dyn-bind-empty"></div>
                    <div class="projects-card-link-page">
                      <div>Explore More →</div>
